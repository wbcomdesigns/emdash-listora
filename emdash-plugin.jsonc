{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "listora",
	"name": "Listora",
	"keywords": ["directory", "listings", "reviews", "local business", "classifieds"],
	"publisher": "did:plc:2o6axbe264shvyedyhycyhya",

	"license": "MIT",
	"repo": "https://github.com/wbcomdesigns/emdash-listora",
	"author": { "name": "Wbcom Designs", "url": "https://wbcomdesigns.com", "email": "security@wbcomdesigns.com" },
	"security": { "email": "security@wbcomdesigns.com" },
	"description": "A moderated local directory: search, a map, 10 listing types, member submissions, reviews, claims and a dashboard.",
	"sections": {
		"description": { "file": "./docs/registry/description.md" },
		"installation": { "file": "./docs/registry/installation.md" },
		"faq": { "file": "./docs/registry/faq.md" },
		"changelog": { "file": "./docs/registry/changelog.md" }
	},
	"release": {
		"artifacts": {
			"icon": { "file": "./icon.png" },
			"banner": { "file": "./images/banner.png" },
			"screenshots": [
				{ "file": "./images/screenshot-1-directory.jpg" },
				{ "file": "./images/screenshot-2-listing.jpg" },
				{ "file": "./images/screenshot-3-submit.jpg" },
				{ "file": "./images/screenshot-4-account.jpg" },
				{ "file": "./images/screenshot-5-moderation.jpg" }
			]
		}
	},

	"capabilities": ["content:read", "content:write", "content:publish", "schema:read", "email:send", "taxonomies:read", "taxonomies:write"],
	"allowedHosts": [],
	"storage": {
		"submissions": {
			"indexes": ["status", "createdAt", "title", "member_id"]
		},
		"events": {
			"indexes": ["savedAt", "contentId", "collection"]
		},
		"reviews": {
			"indexes": ["status", "listingId", "member_id", "createdAt"]
		},
		"claims": {
			"indexes": ["status", "listingId", "member_id", "createdAt"]
		},
		"favorites": {
			"indexes": ["member_id", "listingId", "createdAt"]
		},
		"edits": {
			"indexes": ["status", "listingId", "member_id", "createdAt"]
		},
		"contacts": {
			"indexes": ["listingId", "createdAt", "status", "notice"]
		},
		"email_log": {
			"indexes": ["template", "status", "createdAt"]
		},
		"ratings": {
			"indexes": ["count"]
		},
		"blocked": {
			"indexes": ["member_id", "createdAt"]
		}
	},
	"admin": {
		"pages": [
			{
				"path": "/setup",
				"label": "Get started",
				"icon": "sparkle",
				"group": "Listings"
			},
			{
				"path": "/queue",
				"label": "Listings queue",
				"icon": "buildings",
				"group": "Listings"
			},
			{
				"path": "/reviews",
				"label": "Reviews",
				"icon": "star",
				"group": "Listings"
			},
			{
				"path": "/claims",
				"label": "Claims",
				"icon": "badge-check",
				"group": "Listings"
			},
			{
				"path": "/messages",
				"label": "Messages",
				"icon": "envelope",
				"group": "Listings"
			},
			{
				"path": "/settings",
				"label": "Settings",
				"icon": "settings",
				"group": "Listings"
			}
		],
		"widgets": [{ "id": "waiting", "title": "Listora: waiting for you", "size": "half" }],
		"settingsSchema": {
			"require_moderation": {
				"label": "Require moderation",
				"description": "Keep public submissions as drafts until someone approves them.",
				"type": "boolean",
				"default": true
			},
			"email_messages": {
				"label": "Email the listing owner when a message arrives",
				"description": "A short notice to the owner's account email. The message itself stays on the site. Needs a mail provider.",
				"type": "boolean",
				"default": true
			},
			"default_listing_type": {
				"label": "Default listing type",
				"type": "select",
				"default": "business",
				"options": [
					{ "value": "business", "label": "Business" },
					{ "value": "restaurant", "label": "Restaurant" },
					{ "value": "real-estate", "label": "Real estate" },
					{ "value": "hotel", "label": "Hotel" },
					{ "value": "event", "label": "Event" },
					{ "value": "job", "label": "Job" },
					{ "value": "healthcare", "label": "Healthcare" },
					{ "value": "education", "label": "Education" },
					{ "value": "place", "label": "Place" },
					{ "value": "classified", "label": "Classified" }
				]
			},
			"expiry_days": {
				"label": "Listings expire after this many days (0 = never)",
				"description": "0 means listings never expire.",
				"type": "number",
				"default": 0
			},
			"email_expiry": {
				"label": "Email the owner 7 days before their listing expires",
				"description": "One short notice to the owner's account email. Needs a mail provider.",
				"type": "boolean",
				"default": true
			},
			"spam_keywords": {
				"label": "Spam keywords",
				"description": "Comma-separated words that reject a public submit.",
				"type": "string",
				"default": "viagra, crypto pump"
			}
		}
	}
}
