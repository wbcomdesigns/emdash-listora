---
import { getEmDashCollection, getSiteSettings, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Layout from "../../layouts/ListoraLayout.astro";
import {
	LISTING_TYPES,
	placeholderHtml,
	isOpenNow,
	callListoraRoute,
	siteZone,
	matchesPlace,
	parseHours,
	placeOf,
	sortListings,
	typeName,
} from "../../lib/listora";
import { listingCount, pageOf, resultCount, saveNamed, S } from "../../lib/listora-strings";
import "../../styles/listora-ui.css";

const type = Astro.url.searchParams.get("type") || "";
const q = Astro.url.searchParams.get("q") || "";
const location = Astro.url.searchParams.get("location") || "";
const category = Astro.url.searchParams.get("category") || "";
// One zone for the whole directory: the site's own, from EmDash's settings.
const zone = siteZone((await getSiteSettings())?.timezone);
const view = Astro.url.searchParams.get("view") || "grid";
const sort = Astro.url.searchParams.get("sort") || "featured";

const { entries, cacheHint } = await getEmDashCollection("listings", {
	orderBy: { published_at: "desc" },
	limit: 500,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const published = entries.filter((entry) => entry.data.listing_status !== "expired");
// Categories are the site's own `listing_category` terms. One read covers every listing on the page.
type Term = { slug: string; label: string };
const termsByListing: Map<string, Term[]> = published.length
	? await getTermsForEntries("listings", published.map((entry) => entry.data.id), "listing_category").catch(() => new Map())
	: new Map();
const inCategory = (id: string, slug: string) => (termsByListing.get(id) ?? []).some((term) => term.slug === slug);
const tally = <T extends { label: string }>(map: Map<string, T & { count: number }>, key: string, value: T) =>
	map.set(key, { ...value, count: (map.get(key)?.count ?? 0) + 1 });
const categoryCounts = new Map<string, Term & { count: number }>();
const cityCounts = new Map<string, { label: string; count: number }>();
for (const entry of published) {
	for (const term of termsByListing.get(entry.data.id) ?? []) tally(categoryCounts, term.slug, term);
	const city = String(entry.data.city || "").trim();
	if (city) tally(cityCounts, city.toLowerCase(), { label: city });
}
const byCount = <T extends { label: string; count: number }>(map: Map<string, T>) =>
	[...map.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label)).slice(0, 12);
const categoryFacets = byCount(categoryCounts);
const cityFacets = byCount(cityCounts);
// Type chips only for types this directory uses (plus the one being viewed), like the city chips.
const typesInUse = new Set(published.map((entry) => String(entry.data.listing_type || "")).filter(Boolean));
const typeChips = LISTING_TYPES.filter((item) => typesInUse.has(item.slug) || item.slug === type);

// Ratings live in plugin storage, so sorting by rating asks the plugin once. If that fails
// the list keeps its normal order: the page never breaks over a sort.
let ratings: Record<string, { average: number }> = {};
if (sort === "rating") {
	const answer = await callListoraRoute(Astro.locals, "ratings?all=1").catch(() => null);
	ratings = (answer?.ratings as Record<string, { average: number }> | undefined) ?? {};
}

const matching = sortListings(
	published.filter((entry) => {
		if (type && entry.data.listing_type !== type) return false;
		if (category && !inCategory(entry.data.id, category)) return false;
		if (!matchesPlace(entry.data, location)) return false;
		if (!q) return true;
		const hay = `${entry.data.title} ${entry.data.excerpt} ${placeOf(entry.data)} ${entry.data.listing_type}`.toLowerCase();
		return hay.includes(q.toLowerCase());
	}),
	sort,
);
const filtered =
	sort === "rating"
		? [...matching].sort((a, b) => (ratings[b.data.id]?.average ?? 0) - (ratings[a.data.id]?.average ?? 0))
		: matching;
const featured = published.filter((entry) => entry.data.is_featured).slice(0, 3);
// The featured row shows on the plain directory only. Its listings are then left out of the
// list below, so nothing appears twice. Counts still say how many listings there are in all.
const showFeatured = featured.length > 0 && !q && !type && !location && !category;
const featuredIds = new Set(showFeatured ? featured.map((entry) => entry.id) : []);
const listed = filtered.filter((entry) => !featuredIds.has(entry.id));
const PER_PAGE = 24;
const pages = Math.max(1, Math.ceil(listed.length / PER_PAGE));
const page = Math.min(Math.max(Number(Astro.url.searchParams.get("page")) || 1, 1), pages);
const shown = listed.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const querySuffix = [
	type ? `type=${encodeURIComponent(type)}` : "",
	q ? `q=${encodeURIComponent(q)}` : "",
	location ? `location=${encodeURIComponent(location)}` : "",
	category ? `category=${encodeURIComponent(category)}` : "",
	sort !== "featured" ? `sort=${encodeURIComponent(sort)}` : "",
]
	.filter(Boolean)
	.join("&");
// A facet link keeps the listing type and swaps only its own filter.
const facetHref = (key: "category" | "location", value: string) =>
	`/listings/?${new URLSearchParams({ ...(type ? { type } : {}), ...(value ? { [key]: value } : {}) })}`;
const withQuery = (extra: string) => `/listings/?${[extra, querySuffix].filter(Boolean).join("&")}`;

function amenityLabel(item: string): string {
	return item.replace(/[-_]/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());
}

function amenityList(value: unknown): string[] {
	const raw = Array.isArray(value)
		? value.map(String)
		: typeof value === "string" && value.trim()
			? (() => {
					try {
						const parsed = JSON.parse(value);
						return Array.isArray(parsed) ? parsed.map(String) : value.split(",");
					} catch {
						return value.split(",");
					}
				})()
			: [];
	return raw.map((item) => amenityLabel(item.trim())).filter(Boolean).slice(0, 3);
}
---

<Layout title={S.directory.title} description={S.directory.description}>
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>{S.directory.heading}</h1>
				<p id="listora-count">{listingCount(filtered.length)}</p>
			</div>
			<a class="listora-btn" href="/listings/submit/">{S.directory.add}</a>
		</header>

		<form class="listora-search" role="search" id="listora-search-form">
			<div class="listora-search__bar">
				<div class="listora-search__field listora-search__field--keyword">
					<label class="listora-sr-only" for="listora-q">{S.directory.searchLabel}</label>
					<svg class="listora-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.3-4.3"></path>
					</svg>
					<input
						id="listora-q"
						class="listora-input listora-search__input"
						type="search"
						name="q"
						value={q}
						placeholder={S.directory.searchPlaceholder}
						autocomplete="off"
					/>
					<button class="listora-search__clear" type="button" id="listora-clear" hidden={q === ""} aria-label={S.directory.clearSearch}>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M18 6 6 18"></path>
							<path d="m6 6 12 12"></path>
						</svg>
					</button>
				</div>
				<div class="listora-search__field listora-search__field--location">
					<label class="listora-sr-only" for="listora-location">{S.directory.locationLabel}</label>
					<svg class="listora-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<input
						id="listora-location"
						class="listora-input listora-search__input"
						type="text"
						name="location"
						value={location}
						placeholder={S.directory.locationPlaceholder}
						autocomplete="off"
					/>
				</div>
				<button class="listora-btn listora-search__submit" type="submit">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.3-4.3"></path>
					</svg>
					<span>{S.directory.search}</span>
				</button>
			</div>
			{(typeChips.length > 1 || type) && (
			<div class="listora-chips" id="listora-types">
				<a class:list={{ "listora-chip": true, "is-active": !type }} href="/listings/">{S.directory.all}</a>
				{
					typeChips.map((item) => (
						<a
							class:list={{ "listora-chip": true, "is-active": type === item.slug }}
							href={`/listings/?type=${item.slug}`}
							data-type={item.slug}
						>
							{item.name}
						</a>
					))
				}
			</div>
			)}
			{category ? <input type="hidden" name="category" value={category} /> : null}
		</form>

		{
			categoryFacets.length > 0 || cityFacets.length > 1 ? (
				<nav class="listora-facets" aria-label={S.directory.browse}>
					{categoryFacets.length > 0 ? (
						<div class="listora-facets__row">
							<h2 class="listora-meta" id="facet-category">{S.directory.category}</h2>
							<ul class="listora-chips" aria-labelledby="facet-category">
								{categoryFacets.map((item) => (
									<li>
										<a
											class:list={{ "listora-chip": true, "is-active": category === item.slug }}
											href={facetHref("category", category === item.slug ? "" : item.slug)}
											aria-current={category === item.slug ? "true" : undefined}
											data-facet
										>
											{item.label} <span class="listora-chip__count">{item.count}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					) : null}
					{cityFacets.length > 1 ? (
						<div class="listora-facets__row">
							<h2 class="listora-meta" id="facet-city">{S.directory.city}</h2>
							<ul class="listora-chips" aria-labelledby="facet-city">
								{cityFacets.map((item) => {
									const on = location.toLowerCase() === item.label.toLowerCase();
									return (
										<li>
											<a
												class:list={{ "listora-chip": true, "is-active": on }}
												href={facetHref("location", on ? "" : item.label)}
												aria-current={on ? "true" : undefined}
												data-facet
											>
												{item.label} <span class="listora-chip__count">{item.count}</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					) : null}
				</nav>
			) : null
		}

		<div id="listora-featured-slot">
		{
			showFeatured ? (
				<section class="listora-featured" aria-label={S.directory.featuredLabel}>
					<h2 class="listora-meta">{S.common.featured}</h2>
					<div class="listora-featured__track">
						{featured.map((listing) => (
							<article class="listora-card">
								<div class="listora-card-media">
									{listing.data.featured_image ? (
										<Image image={listing.data.featured_image} alt="" />
									) : (
										<Fragment set:html={placeholderHtml(String(listing.data.listing_type || ""))} />
									)}
									<span class="listora-badge">{typeName(listing.data.listing_type)}</span>
									<span class="listora-badge listora-badge--featured">{S.common.featured}</span>
								</div>
								<div class="listora-card-body">
									<h3>
										<a href={`/listings/${listing.id}/`}>{listing.data.title}</a>
									</h3>
									<p class="listora-meta">{placeOf(listing.data)}</p>
								</div>
							</article>
						))}
					</div>
				</section>
			) : null
		}
		</div>

		<div class="listora-toolbar">
			<div id="listora-toolbar-count">{resultCount(filtered.length)}</div>
			<div class="listora-toolbar__actions">
				<label class="listora-sr-only" for="listora-sort">{S.directory.sort}</label>
				<select class="listora-sort" id="listora-sort" name="sort">
					<option value="featured" selected={sort === "featured"}>{S.common.featured}</option>
					<option value="rating" selected={sort === "rating"}>{S.directory.rating}</option>
					<option value="title" selected={sort === "title"}>{S.directory.titleSort}</option>
				</select>
				<div class="listora-view-toggle">
					<a class:list={{ "is-active": view !== "list" }} href={withQuery("view=grid")}>{S.directory.grid}</a>
					<a class:list={{ "is-active": view === "list" }} href={withQuery("view=list")}>{S.directory.list}</a>
				</div>
				<a class="listora-btn listora-btn--ghost" href="/listings/calendar/">{S.directory.calendar}</a>
			</div>
		</div>

		<div id="listora-results" class:list={{ "listora-grid": true, "is-list": view === "list" }}>
			{
				filtered.length === 0 ? (
					<div class="listora-empty">
						<div class="listora-empty__icon" aria-hidden="true">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="m21 21-4.3-4.3"></path>
							</svg>
						</div>
						<h2>{S.directory.emptyTitle}</h2>
						<p>{S.directory.emptyBody}</p>
						<a class="listora-btn" href="/listings/submit/">{S.directory.add}</a>
					</div>
				) : (
					shown.map((listing) => {
						const hours = parseHours(listing.data.hours);
						const open = hours.length ? isOpenNow(hours, zone) : null;
						const amenities = amenityList(listing.data.amenities);
						const owner = String(listing.data.owner_name || "");
						return (
							<article class="listora-card" data-slug={listing.id} data-type={listing.data.listing_type} data-city={listing.data.city} data-lat={listing.data.lat} data-lng={listing.data.lng}>
								<div class="listora-card-media">
									{listing.data.featured_image ? (
										<Image image={listing.data.featured_image} alt="" />
									) : (
										<Fragment set:html={placeholderHtml(String(listing.data.listing_type || ""))} />
									)}
									<span class="listora-badge">{typeName(listing.data.listing_type)}</span>
									{listing.data.is_featured ? <span class="listora-badge listora-badge--featured">{S.common.featured}</span> : null}
									<span class="listora-card__rating" data-rating={listing.data.id} hidden></span>
									<button class="listora-card__favorite" type="button" data-favorite={listing.data.id} aria-pressed="false" aria-label={saveNamed(String(listing.data.title || ""))}>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
											<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
										</svg>
									</button>
								</div>
								<div class="listora-card-body">
									<h2>
										<a href={`/listings/${listing.id}/`}>{listing.data.title}</a>
									</h2>
									<p class="listora-meta">
										<span>{placeOf(listing.data)}</span>
										{open === true ? <span class="listora-open">{S.common.open}</span> : null}
										{open === false ? <span class="listora-closed">{S.common.closed}</span> : null}
									</p>
									{owner ? <p class="listora-meta">{S.directory.listedBy} {owner}</p> : null}
									{amenities.length ? (
										<p class="listora-card__features">
											{amenities.map((item) => <span>{item}</span>)}
										</p>
									) : null}
									{listing.data.excerpt ? <p>{listing.data.excerpt}</p> : null}
								</div>
							</article>
						);
					})
				)
			}
		</div>

		<div id="listora-pager-slot">
		{
			pages > 1 ? (
				<nav class="listora-pager" id="listora-pager" aria-label={S.directory.pages}>
					{page > 1 ? <a class="listora-btn listora-btn--secondary" rel="prev" href={withQuery(`page=${page - 1}`)}>{S.common.previous}</a> : <span></span>}
					<span class="listora-pager__status">{pageOf(page, pages)}</span>
					{page < pages ? <a class="listora-btn listora-btn--secondary" rel="next" href={withQuery(`page=${page + 1}`)}>{S.common.next}</a> : <span></span>}
				</nav>
			) : null
		}
		</div>

		<div class="listora-skeletons" aria-hidden="true">
			<div class="listora-skeleton"></div>
			<div class="listora-skeleton"></div>
			<div class="listora-skeleton"></div>
		</div>

		<div id="listora-map" class="listora-map" hidden></div>
	</div>
</Layout>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
<script>
	import { api, esc, savedIds, signInUrl } from "../../lib/listora";
	import { rated, S } from "../../lib/listora-strings";

	const form = document.getElementById("listora-search-form") as HTMLFormElement | null;
	const q = document.getElementById("listora-q") as HTMLInputElement | null;
	const locationInput = document.getElementById("listora-location") as HTMLInputElement | null;
	const sortSelect = document.getElementById("listora-sort") as HTMLSelectElement | null;
	const results = document.getElementById("listora-results");
	const mapEl = document.getElementById("listora-map");
	const clearBtn = document.getElementById("listora-clear") as HTMLButtonElement | null;
	let activeType = new URLSearchParams(location.search).get("type") || "";
	const activeCategory = new URLSearchParams(location.search).get("category") || "";

	// The parts of the page a search changes. Live search loads this same page for the new
	// query and swaps them in, so there is one way a card is drawn: the server's.
	const LIVE = ["listora-count", "listora-featured-slot", "listora-toolbar-count", "listora-results", "listora-pager-slot"];

	function searchUrl(extra: Record<string, string> = {}): string {
		const params = new URLSearchParams({
			...(q?.value ? { q: q.value } : {}),
			...(locationInput?.value ? { location: locationInput.value } : {}),
			...(activeType ? { type: activeType } : {}),
			...(activeCategory ? { category: activeCategory } : {}),
			...(sortSelect && sortSelect.value !== "featured" ? { sort: sortSelect.value } : {}),
			...(new URLSearchParams(location.search).get("view") === "list" ? { view: "list" } : {}),
			...extra,
		});
		const query = params.toString();
		return query ? `/listings/?${query}` : "/listings/";
	}

	let latest = 0;
	async function runSearch() {
		if (!results || !form) return;
		const url = searchUrl();
		const mine = ++latest;
		form.classList.add("is-busy");
		form.setAttribute("aria-busy", "true");
		let next: Document | null = null;
		try {
			const response = await fetch(url, { headers: { Accept: "text/html" } });
			if (response.ok) next = new DOMParser().parseFromString(await response.text(), "text/html");
		} catch {
			next = null;
		}
		// A slower, older answer must not replace a newer one.
		if (mine !== latest) return;
		form.classList.remove("is-busy");
		form.removeAttribute("aria-busy");
		if (clearBtn) clearBtn.hidden = !(q?.value || "");
		if (!next?.getElementById("listora-results")) {
			results.innerHTML =
				`<div class="listora-empty" role="alert"><h2>${esc(S.directory.searchDownTitle)}</h2><p>${esc(S.directory.searchDownBody)}</p></div>`;
			return;
		}
		for (const id of LIVE) {
			const from = next.getElementById(id);
			const to = document.getElementById(id);
			if (!from || !to) continue;
			to.innerHTML = from.innerHTML;
			if (id === "listora-results") to.className = from.className;
		}
		history.replaceState(null, "", url);
		fillRatings();
		drawMap();
		markSaved();
	}
	// Back and forward bring the matching page.
	window.addEventListener("popstate", () => location.reload());

	// Ratings are not in the page HTML: they come from plugin storage in one request.
	async function fillRatings() {
		const slots = [...document.querySelectorAll<HTMLElement>("[data-rating]")];
		const ids = [...new Set(slots.map((node) => node.dataset.rating ?? ""))].filter(Boolean).slice(0, 80);
		if (!ids.length) return;
		const data = await api(`ratings?ids=${encodeURIComponent(ids.join(","))}`);
		const ratings = (data.ratings ?? {}) as Record<string, { average: number; count: number }>;
		slots.forEach((node) => {
			const rating = ratings[node.dataset.rating ?? ""];
			if (!rating) return;
			node.hidden = false;
			node.textContent = `${"★".repeat(Math.max(1, Math.round(rating.average)))} ${rating.average.toFixed(1)}`;
			node.setAttribute("aria-label", rated(rating.average.toFixed(1), rating.count));
		});
	}
	fillRatings();

	q?.addEventListener("input", () => {
		if (clearBtn) clearBtn.hidden = !q.value;
		window.clearTimeout((q as HTMLInputElement & { t?: number }).t);
		(q as HTMLInputElement & { t?: number }).t = window.setTimeout(() => runSearch(), 280);
	});

	locationInput?.addEventListener("input", () => {
		window.clearTimeout((locationInput as HTMLInputElement & { t?: number }).t);
		(locationInput as HTMLInputElement & { t?: number }).t = window.setTimeout(() => runSearch(), 280);
	});

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		runSearch();
	});

	clearBtn?.addEventListener("click", () => {
		if (q) q.value = "";
		runSearch();
		q?.focus();
	});

	sortSelect?.addEventListener("change", () => runSearch());

	document.getElementById("listora-types")?.addEventListener("click", (event) => {
		const link = (event.target as HTMLElement).closest("a[data-type], a.listora-chip");
		if (!link) return;
		event.preventDefault();
		activeType = (link as HTMLElement).dataset.type || "";
		document.querySelectorAll("#listora-types .listora-chip").forEach((chip) => chip.classList.remove("is-active"));
		link.classList.add("is-active");
		runSearch();
	});

	// The page is the same for every visitor, so which hearts are on is asked after it loads.
	// Asked once: cards drawn later by a search are marked from the same answer.
	let saved = new Set<string>();
	const markSaved = () =>
		document.querySelectorAll<HTMLButtonElement>("[data-favorite]").forEach((button) => {
			const on = saved.has(button.dataset.favorite || "");
			button.classList.toggle("is-on", on);
			button.setAttribute("aria-pressed", String(on));
		});
	savedIds().then((ids) => {
		saved = ids;
		markSaved();
	});

	results?.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-favorite]");
		if (!button) return;
		event.preventDefault();
		const listingId = button.dataset.favorite;
		if (!listingId) return;
		const on = button.classList.contains("is-on");
		const result = await api("favorites", { listingId }, on ? "DELETE" : "POST");
		if (!result.ok) {
			if (result.error?.code === "SIGN_IN_REQUIRED") location.href = signInUrl();
			return;
		}
		if (on) saved.delete(listingId);
		else saved.add(listingId);
		markSaved();
	});

	// The map follows whatever cards are on the page, including after a live search.
	type Leaflet = { map: Function; tileLayer: Function; marker: Function; layerGroup: Function };
	let map: { setView: Function } | null = null;
	let markers: { clearLayers: Function; addLayer: Function } | null = null;
	function drawMap() {
		if (!mapEl) return;
		const points = [...document.querySelectorAll<HTMLElement>("#listora-results [data-lat]")].flatMap((node) => {
			const lat = Number(node.dataset.lat);
			const lng = Number(node.dataset.lng);
			if (!node.dataset.lat || !Number.isFinite(lat) || !Number.isFinite(lng)) return [];
			return [{ lat, lng, title: node.querySelector("h2")?.textContent ?? "" }];
		});
		mapEl.hidden = points.length === 0;
		if (!points.length) return;
		const place = (L: Leaflet) => {
			if (!map) {
				map = L.map(mapEl);
				L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: `&copy; ${esc(S.directory.mapCredit)}` }).addTo(map);
				markers = L.layerGroup().addTo(map);
			}
			markers?.clearLayers();
			for (const point of points) {
				// A text node, never a string: Leaflet puts a string popup in as HTML, and the title is member-written.
				const popup = document.createElement("span");
				popup.textContent = point.title;
				markers?.addLayer(L.marker([point.lat, point.lng]).bindPopup(popup));
			}
			map?.setView([points[0].lat, points[0].lng], 12);
		};
		const ready = (window as unknown as { L?: Leaflet }).L;
		if (ready) return place(ready);
		if (document.getElementById("listora-leaflet")) return;
		const leaflet = document.createElement("script");
		leaflet.id = "listora-leaflet";
		leaflet.src = "/vendor/leaflet/leaflet.js";
		leaflet.onload = () => drawMap();
		document.body.append(leaflet);
	}
	drawMap();
</script>
