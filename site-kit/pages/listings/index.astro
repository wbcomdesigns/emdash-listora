---
import { getEmDashCollection, getSiteSettings, getTermsForEntries } from "emdash";
import { Image } from "emdash/ui";
import Layout from "../../layouts/ListoraLayout.astro";
import {
	LISTING_TYPES,
	coverUrl,
	isOpenNow,
	siteZone,
	matchesPlace,
	parseHours,
	placeOf,
	sortListings,
	typeName,
} from "../../lib/listora";
import "../../styles/listora-ui.css";

const type = Astro.url.searchParams.get("type") || "";
const q = Astro.url.searchParams.get("q") || "";
const location = Astro.url.searchParams.get("location") || "";
const category = Astro.url.searchParams.get("category") || "";
// One zone for the whole directory: the site's own, from EmDash's settings.
const zone = siteZone((await getSiteSettings())?.timezone);
const view = Astro.url.searchParams.get("view") || "grid";
const sort = Astro.url.searchParams.get("sort") || "featured";

const { entries, cacheHint } = await getEmDashCollection("listings", {
	orderBy: { published_at: "desc" },
	limit: 500,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const published = entries.filter((entry) => entry.data.listing_status !== "expired");
// Categories are the site's own `listing_category` terms. One read covers every listing on the page.
type Term = { slug: string; label: string };
const termsByListing: Map<string, Term[]> = published.length
	? await getTermsForEntries("listings", published.map((entry) => entry.data.id), "listing_category").catch(() => new Map())
	: new Map();
const inCategory = (id: string, slug: string) => (termsByListing.get(id) ?? []).some((term) => term.slug === slug);
const tally = <T extends { label: string }>(map: Map<string, T & { count: number }>, key: string, value: T) =>
	map.set(key, { ...value, count: (map.get(key)?.count ?? 0) + 1 });
const categoryCounts = new Map<string, Term & { count: number }>();
const cityCounts = new Map<string, { label: string; count: number }>();
for (const entry of published) {
	for (const term of termsByListing.get(entry.data.id) ?? []) tally(categoryCounts, term.slug, term);
	const city = String(entry.data.city || "").trim();
	if (city) tally(cityCounts, city.toLowerCase(), { label: city });
}
const byCount = <T extends { label: string; count: number }>(map: Map<string, T>) =>
	[...map.values()].sort((a, b) => b.count - a.count || a.label.localeCompare(b.label)).slice(0, 12);
const categoryFacets = byCount(categoryCounts);
const cityFacets = byCount(cityCounts);

const filtered = sortListings(
	published.filter((entry) => {
		if (type && entry.data.listing_type !== type) return false;
		if (category && !inCategory(entry.data.id, category)) return false;
		if (!matchesPlace(entry.data, location)) return false;
		if (!q) return true;
		const hay = `${entry.data.title} ${entry.data.excerpt} ${placeOf(entry.data)} ${entry.data.listing_type}`.toLowerCase();
		return hay.includes(q.toLowerCase());
	}),
	sort,
);
const featured = published.filter((entry) => entry.data.is_featured);
const PER_PAGE = 24;
const pages = Math.max(1, Math.ceil(filtered.length / PER_PAGE));
const page = Math.min(Math.max(Number(Astro.url.searchParams.get("page")) || 1, 1), pages);
const shown = filtered.slice((page - 1) * PER_PAGE, page * PER_PAGE);
const querySuffix = [
	type ? `type=${encodeURIComponent(type)}` : "",
	q ? `q=${encodeURIComponent(q)}` : "",
	location ? `location=${encodeURIComponent(location)}` : "",
	category ? `category=${encodeURIComponent(category)}` : "",
	sort !== "featured" ? `sort=${encodeURIComponent(sort)}` : "",
]
	.filter(Boolean)
	.join("&");
// A facet link keeps the listing type and swaps only its own filter.
const facetHref = (key: "category" | "location", value: string) =>
	`/listings/?${new URLSearchParams({ ...(type ? { type } : {}), ...(value ? { [key]: value } : {}) })}`;
const withQuery = (extra: string) => `/listings/?${[extra, querySuffix].filter(Boolean).join("&")}`;

function amenityLabel(item: string): string {
	return item.replace(/[-_]/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());
}

function amenityList(value: unknown): string[] {
	const raw = Array.isArray(value)
		? value.map(String)
		: typeof value === "string" && value.trim()
			? (() => {
					try {
						const parsed = JSON.parse(value);
						return Array.isArray(parsed) ? parsed.map(String) : value.split(",");
					} catch {
						return value.split(",");
					}
				})()
			: [];
	return raw.map((item) => amenityLabel(item.trim())).filter(Boolean).slice(0, 3);
}
---

<Layout title="Listings" description="Browse the directory. Search by type, place, or name.">
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>Listings</h1>
				<p id="listora-count">{filtered.length === 1 ? "1 listing" : `${filtered.length} listings`}</p>
			</div>
			<a class="listora-btn" href="/listings/submit/">Add a listing</a>
		</header>

		<form class="listora-search" role="search" id="listora-search-form" data-zone={zone}>
			<div class="listora-search__bar">
				<div class="listora-search__field listora-search__field--keyword">
					<label class="listora-sr-only" for="listora-q">Search</label>
					<svg class="listora-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.3-4.3"></path>
					</svg>
					<input
						id="listora-q"
						class="listora-input listora-search__input"
						type="search"
						name="q"
						value={q}
						placeholder="Search listings"
						autocomplete="off"
					/>
					<button class="listora-search__clear" type="button" id="listora-clear" hidden={q === ""} aria-label="Clear search">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M18 6 6 18"></path>
							<path d="m6 6 12 12"></path>
						</svg>
					</button>
				</div>
				<div class="listora-search__field listora-search__field--location">
					<label class="listora-sr-only" for="listora-location">Location</label>
					<svg class="listora-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<input
						id="listora-location"
						class="listora-input listora-search__input"
						type="text"
						name="location"
						value={location}
						placeholder="City or neighborhood"
						autocomplete="off"
					/>
					<button class="listora-search__near-me" type="button" id="listora-near" aria-label="Find listings near your location">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
						</svg>
					</button>
				</div>
				<button class="listora-btn listora-search__submit" type="submit">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.3-4.3"></path>
					</svg>
					<span>Search</span>
				</button>
			</div>
			<div class="listora-chips" id="listora-types">
				<a class:list={{ "listora-chip": true, "is-active": !type }} href="/listings/">All</a>
				{
					LISTING_TYPES.map((item) => (
						<a
							class:list={{ "listora-chip": true, "is-active": type === item.slug }}
							href={`/listings/?type=${item.slug}`}
							data-type={item.slug}
						>
							{item.name}
						</a>
					))
				}
			</div>
			{category ? <input type="hidden" name="category" value={category} /> : null}
		</form>

		{
			categoryFacets.length > 0 || cityFacets.length > 1 ? (
				<nav class="listora-facets" aria-label="Browse the directory">
					{categoryFacets.length > 0 ? (
						<div class="listora-facets__row">
							<h2 class="listora-meta" id="facet-category">Category</h2>
							<ul class="listora-chips" aria-labelledby="facet-category">
								{categoryFacets.map((item) => (
									<li>
										<a
											class:list={{ "listora-chip": true, "is-active": category === item.slug }}
											href={facetHref("category", category === item.slug ? "" : item.slug)}
											aria-current={category === item.slug ? "true" : undefined}
											data-facet
										>
											{item.label} <span class="listora-chip__count">{item.count}</span>
										</a>
									</li>
								))}
							</ul>
						</div>
					) : null}
					{cityFacets.length > 1 ? (
						<div class="listora-facets__row">
							<h2 class="listora-meta" id="facet-city">City</h2>
							<ul class="listora-chips" aria-labelledby="facet-city">
								{cityFacets.map((item) => {
									const on = location.toLowerCase() === item.label.toLowerCase();
									return (
										<li>
											<a
												class:list={{ "listora-chip": true, "is-active": on }}
												href={facetHref("location", on ? "" : item.label)}
												aria-current={on ? "true" : undefined}
												data-facet
											>
												{item.label} <span class="listora-chip__count">{item.count}</span>
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					) : null}
				</nav>
			) : null
		}

		{
			featured.length > 0 && !q && !type && !location && !category ? (
				<section class="listora-featured" aria-label="Featured listings">
					<h2 class="listora-meta">Featured</h2>
					<div class="listora-featured__track">
						{featured.slice(0, 3).map((listing) => (
							<article class="listora-card">
								<div class="listora-card-media">
									{listing.data.featured_image ? (
										<Image image={listing.data.featured_image} alt="" />
									) : (
										<img src={coverUrl(String(listing.id), listing.data.featured_image, String(listing.data.listing_type || ""))} alt="" width="800" height="500" />
									)}
									<span class="listora-badge">{typeName(listing.data.listing_type)}</span>
									<span class="listora-badge listora-badge--featured">Featured</span>
								</div>
								<div class="listora-card-body">
									<h3>
										<a href={`/listings/${listing.id}/`}>{listing.data.title}</a>
									</h3>
									<p class="listora-meta">{placeOf(listing.data)}</p>
								</div>
							</article>
						))}
					</div>
				</section>
			) : null
		}

		<div class="listora-toolbar">
			<div id="listora-toolbar-count">{filtered.length === 1 ? "1 result" : `${filtered.length} results`}</div>
			<div class="listora-toolbar__actions">
				<label class="listora-sr-only" for="listora-sort">Sort</label>
				<select class="listora-sort" id="listora-sort" name="sort">
					<option value="featured" selected={sort === "featured"}>Featured</option>
					<option value="rating" selected={sort === "rating"}>Rating</option>
					<option value="title" selected={sort === "title"}>Title</option>
				</select>
				<div class="listora-view-toggle">
					<a class:list={{ "is-active": view !== "list" }} href={withQuery("view=grid")}>Grid</a>
					<a class:list={{ "is-active": view === "list" }} href={withQuery("view=list")}>List</a>
				</div>
				<a class="listora-btn listora-btn--ghost" href="/listings/calendar/">Calendar</a>
			</div>
		</div>

		<div id="listora-results" class:list={{ "listora-grid": true, "is-list": view === "list" }}>
			{
				filtered.length === 0 ? (
					<div class="listora-empty">
						<div class="listora-empty__icon" aria-hidden="true">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="m21 21-4.3-4.3"></path>
							</svg>
						</div>
						<h2>No listings match</h2>
						<p>Try another type or city. You can also add a listing.</p>
						<a class="listora-btn" href="/listings/submit/">Add a listing</a>
					</div>
				) : (
					shown.map((listing) => {
						const hours = parseHours(listing.data.hours);
						const open = hours.length ? isOpenNow(hours, zone) : null;
						const amenities = amenityList(listing.data.amenities);
						const owner = String(listing.data.owner_name || "");
						return (
							<article class="listora-card" data-slug={listing.id} data-type={listing.data.listing_type} data-city={listing.data.city} data-lat={listing.data.lat} data-lng={listing.data.lng}>
								<div class="listora-card-media">
									{listing.data.featured_image ? (
										<Image image={listing.data.featured_image} alt="" />
									) : (
										<img src={coverUrl(String(listing.id), listing.data.featured_image, String(listing.data.listing_type || ""))} alt="" width="800" height="500" />
									)}
									<span class="listora-badge">{typeName(listing.data.listing_type)}</span>
									{listing.data.is_featured ? <span class="listora-badge listora-badge--featured">Featured</span> : null}
									<span class="listora-card__rating" data-rating={listing.data.id} hidden></span>
									<button class="listora-card__favorite" type="button" data-favorite={listing.data.id} aria-label={`Save ${listing.data.title}`}>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
											<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
										</svg>
									</button>
								</div>
								<div class="listora-card-body">
									<h2>
										<a href={`/listings/${listing.id}/`}>{listing.data.title}</a>
									</h2>
									<p class="listora-meta">
										<span>{placeOf(listing.data)}</span>
										{open === true ? <span class="listora-open">Open</span> : null}
										{open === false ? <span class="listora-closed">Closed</span> : null}
									</p>
									{owner ? <p class="listora-meta">Listed by {owner}</p> : null}
									{amenities.length ? (
										<p class="listora-card__features">
											{amenities.map((item) => <span>{item}</span>)}
										</p>
									) : null}
									{listing.data.excerpt ? <p>{listing.data.excerpt}</p> : null}
								</div>
							</article>
						);
					})
				)
			}
		</div>

		{
			pages > 1 ? (
				<nav class="listora-pager" id="listora-pager" aria-label="Pages of listings">
					{page > 1 ? <a class="listora-btn listora-btn--secondary" rel="prev" href={withQuery(`page=${page - 1}`)}>Previous</a> : <span></span>}
					<span class="listora-pager__status">Page {page} of {pages}</span>
					{page < pages ? <a class="listora-btn listora-btn--secondary" rel="next" href={withQuery(`page=${page + 1}`)}>Next</a> : <span></span>}
				</nav>
			) : null
		}
		<p class="listora-pager" id="listora-more" hidden><a class="listora-btn listora-btn--secondary" href="/listings/">See all results</a></p>

		<div class="listora-skeletons" aria-hidden="true">
			<div class="listora-skeleton"></div>
			<div class="listora-skeleton"></div>
			<div class="listora-skeleton"></div>
		</div>

		<div id="listora-map" class="listora-map" hidden></div>
	</div>
</Layout>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
<script>
	import { api, isOpenNow, signInUrl } from "../../lib/listora";

	const form = document.getElementById("listora-search-form") as HTMLFormElement | null;
	const q = document.getElementById("listora-q") as HTMLInputElement | null;
	const locationInput = document.getElementById("listora-location") as HTMLInputElement | null;
	const sortSelect = document.getElementById("listora-sort") as HTMLSelectElement | null;
	const results = document.getElementById("listora-results");
	const count = document.getElementById("listora-count");
	const toolbar = document.getElementById("listora-toolbar-count");
	const mapEl = document.getElementById("listora-map");
	const featuredEl = document.querySelector(".listora-featured");
	const clearBtn = document.getElementById("listora-clear") as HTMLButtonElement | null;
	// The same zone the server used for the cards already on the page.
	const zone = form?.dataset.zone || "UTC";
	let activeType = new URLSearchParams(location.search).get("type") || "";
	const activeCategory = new URLSearchParams(location.search).get("category") || "";
	let near: { lat: string; lng: string } | null = null;

	const TYPE_COVERS: Record<string, string> = {
		business: "photo-1441986300917-64674bd600d8",
		restaurant: "photo-1414235077428-338989a2e8c0",
		"real-estate": "photo-1568605114967-8130f3a36994",
		hotel: "photo-1566073771259-6a8506099945",
		event: "photo-1540575467063-178a50c2df87",
		job: "photo-1521737711867-e3b97375f902",
		healthcare: "photo-1519494026892-80bbd2d6fd0d",
		education: "photo-1503676260728-1c00da094a0b",
		place: "photo-1449824913935-59a10b8d2000",
		classified: "photo-1556742049-0cfed4f6a45d",
	};

	function cover(slug: string, type: string) {
		const id = TYPE_COVERS[type] || TYPE_COVERS.business;
		return `https://images.unsplash.com/${id}?auto=format&fit=crop&w=800&h=500&q=80&sig=${encodeURIComponent(slug)}`;
	}

	function escapeHtml(value: string) {
		return value.replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char] || char);
	}

	function cardHtml(item: {
		id: string;
		slug: string;
		title: string;
		listing_type: string;
		type_name: string;
		city: string;
		country: string;
		excerpt: string;
		is_featured: boolean;
		rating_avg: number;
		hours?: Array<{ day: number; open: string; close: string }>;
		owner_name?: string;
		amenities?: string[];
		lat?: number;
		lng?: number;
	}) {
		const place = [item.city, item.country].filter(Boolean).join(", ");
		const amenities = (item.amenities || []).slice(0, 3).map((row) =>
			row.replace(/[-_]/g, " ").replace(/\b\w/g, (char) => char.toUpperCase()),
		);
		return `<article class="listora-card" data-slug="${escapeHtml(item.slug)}" data-lat="${item.lat ?? ""}" data-lng="${item.lng ?? ""}">
			<div class="listora-card-media">
				<img src="${cover(item.slug, item.listing_type)}" alt="" width="800" height="500" />
				<span class="listora-badge">${escapeHtml(item.type_name)}</span>
				${item.is_featured ? '<span class="listora-badge listora-badge--featured">Featured</span>' : ""}
				${item.rating_avg ? `<span class="listora-card__rating">${"★".repeat(Math.max(1, Math.round(item.rating_avg)))} ${item.rating_avg.toFixed(1)}</span>` : ""}
				<button class="listora-card__favorite" type="button" data-favorite="${escapeHtml(item.id)}" aria-label="Save ${escapeHtml(item.title)}">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
				</button>
			</div>
			<div class="listora-card-body">
				<h2><a href="/listings/${escapeHtml(item.slug)}/">${escapeHtml(item.title)}</a></h2>
				<p class="listora-meta">
					<span>${escapeHtml(place)}</span>
					${item.hours?.length ? (isOpenNow(item.hours, zone) ? '<span class="listora-open">Open</span>' : '<span class="listora-closed">Closed</span>') : ""}
				</p>
				${item.owner_name ? `<p class="listora-meta">Listed by ${escapeHtml(item.owner_name)}</p>` : ""}
				${amenities.length ? `<p class="listora-card__features">${amenities.map((row) => `<span>${escapeHtml(row)}</span>`).join("")}</p>` : ""}
				${item.excerpt ? `<p>${escapeHtml(item.excerpt)}</p>` : ""}
			</div>
		</article>`;
	}

	function emptyHtml() {
		return `<div class="listora-empty">
			<div class="listora-empty__icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg></div>
			<h2>No listings match</h2>
			<p>Try another type or city. You can also add a listing.</p>
			<a class="listora-btn" href="/listings/submit/">Add a listing</a>
		</div>`;
	}

	async function runSearch(extra: Record<string, string> = {}) {
		if (!results || !form) return;
		// A category filter is applied by the page itself, so keep it by loading the filtered page.
		if (activeCategory) {
			window.location.href = `/listings/?${new URLSearchParams({
				...(q?.value ? { q: q.value } : {}),
				...(locationInput?.value ? { location: locationInput.value } : {}),
				...(activeType ? { type: activeType } : {}),
				...(sortSelect && sortSelect.value !== "featured" ? { sort: sortSelect.value } : {}),
				category: activeCategory,
			})}`;
			return;
		}
		form.classList.add("is-busy");
		form.setAttribute("aria-busy", "true");
		const params = new URLSearchParams({
			q: q?.value || "",
			location: locationInput?.value || "",
			listing_type: activeType,
			sort: sortSelect?.value || "featured",
			...extra,
		});
		if (near) {
			params.set("lat", near.lat);
			params.set("lng", near.lng);
			params.set("radius", "8");
		}
		const data = await api(`search?${params}`);
		form.classList.remove("is-busy");
		form.removeAttribute("aria-busy");
		if (!data.ok) {
			results.innerHTML = `<div class="listora-empty" role="alert"><h2>Search is not available right now</h2><p>${escapeHtml(data.error?.message || "Try again in a moment.")}</p></div>`;
			return;
		}
		const json = { data: data as { items?: Array<Parameters<typeof cardHtml>[0]>; total?: number } };
		const items = json.data?.items ?? [];
		const total = json.data?.total ?? items.length;
		results.innerHTML = items.length === 0 ? emptyHtml() : items.map((item) => cardHtml(item)).join("");
		if (count) count.textContent = total === 1 ? "1 listing" : `${total} listings`;
		if (toolbar) toolbar.textContent = total === 1 ? "1 result" : `${total} results`;
		// Live search shows the first page. The full list is the same query as a normal paged page.
		document.getElementById("listora-pager")?.setAttribute("hidden", "");
		const more = document.getElementById("listora-more");
		const link = more?.querySelector("a");
		if (more && link) {
			more.hidden = total <= items.length;
			const full = new URLSearchParams();
			if (params.get("q")) full.set("q", params.get("q")!);
			if (params.get("listing_type")) full.set("type", params.get("listing_type")!);
			if (params.get("location")) full.set("location", params.get("location")!);
			if (params.get("sort") && params.get("sort") !== "featured") full.set("sort", params.get("sort")!);
			link.href = `/listings/?${full}`;
			link.textContent = `See all ${total} results`;
		}
		if (featuredEl instanceof HTMLElement) {
			featuredEl.hidden = Boolean(activeType || q?.value || locationInput?.value || near);
		}
		form.classList.remove("is-busy");
		form.removeAttribute("aria-busy");
		if (clearBtn) clearBtn.hidden = !(q?.value || "");
	}

	// Ratings are not in the page HTML: they come from plugin storage in one request.
	async function fillRatings() {
		const slots = [...document.querySelectorAll<HTMLElement>("[data-rating]")];
		const ids = [...new Set(slots.map((node) => node.dataset.rating ?? ""))].filter(Boolean).slice(0, 80);
		if (!ids.length) return;
		const data = await api(`ratings?ids=${encodeURIComponent(ids.join(","))}`);
		const ratings = (data.ratings ?? {}) as Record<string, { average: number; count: number }>;
		slots.forEach((node) => {
			const rating = ratings[node.dataset.rating ?? ""];
			if (!rating) return;
			node.hidden = false;
			node.textContent = `${"★".repeat(Math.max(1, Math.round(rating.average)))} ${rating.average.toFixed(1)}`;
			node.setAttribute("aria-label", `Rated ${rating.average.toFixed(1)} out of 5 from ${rating.count} reviews`);
		});
	}
	// Sorting by rating needs the stored ratings, so that order comes from the search route.
	if (new URLSearchParams(location.search).get("sort") === "rating") runSearch();
	else fillRatings();

	q?.addEventListener("input", () => {
		if (clearBtn) clearBtn.hidden = !q.value;
		window.clearTimeout((q as HTMLInputElement & { t?: number }).t);
		(q as HTMLInputElement & { t?: number }).t = window.setTimeout(() => (activeCategory ? undefined : runSearch()), 220);
	});

	locationInput?.addEventListener("input", () => {
		window.clearTimeout((locationInput as HTMLInputElement & { t?: number }).t);
		(locationInput as HTMLInputElement & { t?: number }).t = window.setTimeout(() => (activeCategory ? undefined : runSearch()), 220);
	});

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		runSearch();
	});

	clearBtn?.addEventListener("click", () => {
		if (q) q.value = "";
		runSearch();
		q?.focus();
	});

	sortSelect?.addEventListener("change", () => runSearch());

	document.getElementById("listora-types")?.addEventListener("click", (event) => {
		const link = (event.target as HTMLElement).closest("a[data-type], a.listora-chip");
		if (!link) return;
		event.preventDefault();
		activeType = (link as HTMLElement).dataset.type || "";
		document.querySelectorAll("#listora-types .listora-chip").forEach((chip) => chip.classList.remove("is-active"));
		link.classList.add("is-active");
		runSearch();
	});

	document.getElementById("listora-near")?.addEventListener("click", () => {
		navigator.geolocation?.getCurrentPosition(
			(pos) => {
				near = { lat: String(pos.coords.latitude), lng: String(pos.coords.longitude) };
				runSearch();
			},
			() => {
				near = { lat: "40.758", lng: "-73.985" };
				if (locationInput) locationInput.value = "New York";
				runSearch();
			},
		);
	});

	results?.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-favorite]");
		if (!button) return;
		event.preventDefault();
		const listingId = button.dataset.favorite;
		if (!listingId) return;
		const on = button.classList.contains("is-on");
		const result = await api("favorites", { listingId }, on ? "DELETE" : "POST");
		if (!result.ok) {
			if (result.error?.code === "SIGN_IN_REQUIRED") location.href = signInUrl();
			return;
		}
		button.setAttribute("aria-pressed", String(!on));
		button.classList.toggle("is-on", !on);
	});

	if (mapEl) {
		const points = [...document.querySelectorAll<HTMLElement>("[data-lat]")].flatMap((node) => {
			const lat = Number(node.dataset.lat);
			const lng = Number(node.dataset.lng);
			if (!Number.isFinite(lat) || !Number.isFinite(lng)) return [];
			return [{ lat, lng, title: node.querySelector("h2")?.textContent ?? "" }];
		});
		if (points.length) {
			mapEl.hidden = false;
			const leaflet = document.createElement("script");
			leaflet.src = "/vendor/leaflet/leaflet.js";
			leaflet.onload = () => {
				const L = (window as unknown as { L: { map: Function; tileLayer: Function; marker: Function } }).L;
				const map = L.map(mapEl).setView([points[0].lat, points[0].lng], 12);
				L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
					attribution: "&copy; OpenStreetMap",
				}).addTo(map);
				for (const point of points) L.marker([point.lat, point.lng]).addTo(map).bindPopup(point.title);
			};
			document.body.append(leaflet);
		}
	}
</script>
