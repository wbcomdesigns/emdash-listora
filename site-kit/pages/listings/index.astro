---
import { getCollectionInfo, getEmDashCollection, getSiteSettings, getTaxonomyTerms, search } from "emdash";
import { Image } from "emdash/ui";
import Layout from "../../layouts/ListoraLayout.astro";
import {
	cardFacts,
	countLabel,
	hasPlace,
	isSoftware,
	relativeTime,
	softwareView,
	loadTypes,
	placeholderHtml,
	isOpenNow,
	siteZone,
	parseHours,
	placeFor,
	shownTypes,
	typeName as nameOf,
	typeOf,
} from "../../lib/listora";
import { listingCount, pageNumber, pageOf, resultCount, saveNamed, S } from "../../lib/listora-strings";
import { callPluginRoute } from "../../lib/wbcom-kit";
import "../../styles/listora-ui.css";

const get = (key: string) => (Astro.url.searchParams.get(key) || "").trim();
const type = get("type");
const q = get("q");
const location = get("location");
const city = get("city");
const category = get("category");
// One zone for the whole directory: the site's own, from EmDash's settings.
const settings = await getSiteSettings();
const zone = siteZone(settings?.timezone);
const view = get("view") || "grid";
// Names, colours, order and fields come from the plugin's types (the owner edits them in the admin).
const types = await loadTypes(Astro.locals);
// A type without a location: no city search, city chips, map, city or Open and Closed on its cards.
const typeHasPlace = !type || hasPlace(types, type);
// A sort slot means a different field per type, so it is offered only once a type is picked.
const slotSorts = type ? (typeOf(types, type).fields ?? []).filter((field) => field.slot).map((field) => ({ value: `n${field.slot}`, label: field.label })) : [];
const sort = ["rating", "title", ...slotSorts.map((item) => item.value)].includes(get("sort")) ? get("sort") : "featured";
const PER_PAGE = 24;

// Pages go by the position the plugin (or search) hands back. The positions of the pages before
// this one travel in the address (the last ten), so Previous works too.
const after = get("after");
const back = get("back") ? get("back").split(",").slice(-10) : [];
const page = after ? Math.max(Math.floor(Number(get("page"))) || 2, 2) : 1;

type Card = { id: string; is_featured?: boolean };
type Answer = { ok?: boolean; items?: Card[]; total?: number | null; cursor?: string | null; error?: { message?: string } };
const listingsRoute = async (query: Record<string, string>) =>
	(await callPluginRoute(Astro.locals, "listora", `listings?${new URLSearchParams(query)}`).catch(() => null)) as Answer | null;

// The plugin's directory index answers type, category, city and sort, on any number of listings.
const filters: Record<string, string> = {
	...(type ? { type } : {}),
	...(category ? { category } : {}),
	...(city && typeHasPlace ? { city_exact: city } : {}),
	...(location && typeHasPlace ? { location } : {}),
};
const plain = !q && !type && !location && !city && !category;

// Keywords go through EmDash's own site search, best match first; the index then keeps the listings
// that pass the other filters, in that order. A listings collection without Search turned on (or a
// database without full-text search) has the plugin look for the words instead.
let searching = Boolean(q && (await getCollectionInfo("listings").catch(() => null))?.supports?.includes("search"));
async function bySearch(): Promise<Answer | null> {
	const items: Card[] = [];
	let cursor: string | undefined = after || undefined;
	for (let round = 0; round < 3 && items.length < PER_PAGE; round += 1) {
		const hits = await search(q, { collections: ["listings"], limit: PER_PAGE, ...(cursor ? { cursor } : {}) });
		const ids = hits.items.map((hit) => hit.id);
		if (ids.length) {
			const part = await listingsRoute({ ...filters, ids: ids.join(",") });
			if (!part?.ok) return part;
			// An engine before 0.8.0 does not read `ids`: only what search found is kept.
			items.push(...(part.items ?? []).filter((item) => ids.includes(item.id)));
		}
		cursor = hits.nextCursor;
		if (!cursor) break;
	}
	return { ok: true, items, total: null, cursor: cursor ?? null };
}
let answer: Answer | null = null;
if (searching) {
	try {
		answer = await bySearch();
	} catch {
		searching = false;
	}
}
// The featured row shows on the plain directory's first page; its listings are left out of the list below.
let featured: Card[] = [];
if (!searching) {
	if (plain && !after) featured = ((await listingsRoute({ per_page: "3" }))?.items ?? []).filter((item) => item.is_featured);
	answer = await listingsRoute({ ...filters, ...(q ? { q } : {}), ...(sort !== "featured" ? { sort } : {}), per_page: String(PER_PAGE + featured.length), ...(after ? { cursor: after } : {}) });
}
const failed = answer?.ok ? "" : answer?.error?.message || S.directory.searchDownBody;
const featuredIds = new Set(featured.map((item) => item.id));
const cards = (answer?.ok ? (answer.items ?? []) : []).filter((item) => !featuredIds.has(item.id));
const next = answer?.ok ? (answer.cursor ?? "") : "";
const total = answer?.ok && typeof answer.total === "number" ? answer.total : null;

// What a card shows comes from the listings themselves: one read for the listings on this page.
const ids = [...featured, ...cards].map((item) => item.id);
const { entries, cacheHint } = ids.length ? await getEmDashCollection("listings", { where: { id: ids }, limit: ids.length }) : { entries: [], cacheHint: null };
if (cacheHint && Astro.cache?.enabled) Astro.cache.set(cacheHint);
const byId = new Map(entries.map((entry) => [String(entry.data.id), entry]));
const pick = (list: Card[]) => list.flatMap((item) => byId.get(item.id) ?? []);
const featuredEntries = pick(featured);
// An engine before 0.8.0 does not read the city filter: listings elsewhere are left out here.
const shown = pick(cards).filter((entry) => !city || String(entry.data.city || "").trim().toLowerCase() === city.toLowerCase());

// Categories are the site's own `listing_category` terms. EmDash counts the whole directory, so counts show only with no type picked.
type Term = { slug: string; label: string; count?: number; children?: Term[] };
const flat = (terms: Term[]): Term[] => terms.flatMap((term) => [term, ...flat(term.children ?? [])]);
const categoryFacets = flat((await getTaxonomyTerms("listing_category").catch(() => [])) as Term[])
	.filter((term) => (term.count ?? 0) > 0 || term.slug === category)
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0) || a.label.localeCompare(b.label))
	.slice(0, 12);
// City chips: the cities of the listings on this page, and the one being viewed.
const cities = new Map<string, string>();
for (const name of [city, ...shown.filter((entry) => hasPlace(types, entry.data.listing_type)).map((entry) => String(entry.data.city || "").trim())]) {
	if (name && !cities.has(name.toLowerCase())) cities.set(name.toLowerCase(), name);
}
const cityFacets = typeHasPlace ? [...cities.values()].slice(0, 12) : [];
// Type chips for the types the owner offers (plus the one being viewed). A slug the site has no type for shows as the slug.
const typeName = (slug: unknown) => nameOf(types, slug);
const typeChips = [...shownTypes(types), ...(type && !shownTypes(types).some((item) => item.slug === type) ? [typeOf(types, type)] : [])];

// Links keep every filter, the sort and the view; a facet link keeps the listing type and swaps only its own filter.
const base: Record<string, string> = {
	...(type ? { type } : {}),
	...(q ? { q } : {}),
	...(location && typeHasPlace ? { location } : {}),
	...(city && typeHasPlace ? { city } : {}),
	...(category ? { category } : {}),
	...(sort !== "featured" ? { sort } : {}),
};
const link = (extra: Record<string, string>) => {
	const query = new URLSearchParams({ ...base, ...extra }).toString();
	return query ? `/listings/?${query}` : "/listings/";
};
const listView: Record<string, string> = view === "list" ? { view: "list" } : {};
const here: Record<string, string> = after ? { after, page: String(page), ...(back.length ? { back: back.join(",") } : {}) } : {};
const nextHref = next ? link({ after: next, back: [...back, after || "-"].slice(-10).join(","), page: String(page + 1), ...listView }) : "";
const before = back.at(-1);
const prevHref = before && before !== "-" ? link({ after: before, page: String(page - 1), ...(back.length > 1 ? { back: back.slice(0, -1).join(",") } : {}), ...listView }) : link(listView);
const pages = total === null ? 0 : Math.max(page, Math.ceil(Math.max(total - featured.length, 0) / PER_PAGE));
const facetHref = (key: "category" | "city", value: string) =>
	`/listings/?${new URLSearchParams({ ...(type ? { type } : {}), ...(value ? { [key]: value } : {}) })}`;

function amenityLabel(item: string): string {
	return item.replace(/[-_]/g, " ").replace(/\b\w/g, (char) => char.toUpperCase());
}

function amenityList(value: unknown): string[] {
	const raw = Array.isArray(value)
		? value.map(String)
		: typeof value === "string" && value.trim()
			? (() => {
					try {
						const parsed = JSON.parse(value);
						return Array.isArray(parsed) ? parsed.map(String) : value.split(",");
					} catch {
						return value.split(",");
					}
				})()
			: [];
	return raw.map((item) => amenityLabel(item.trim())).filter(Boolean).slice(0, 3);
}
---

<Layout title={S.directory.title} description={S.directory.description}>
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>{S.directory.heading}</h1>
				<p id="listora-count">{total === null ? S.directory.matching : listingCount(total)}</p>
			</div>
			<a class="listora-btn" href="/listings/submit/">{S.directory.add}</a>
		</header>

		<form class="listora-search" role="search" id="listora-search-form">
			<div class="listora-search__bar">
				<div class="listora-search__field listora-search__field--keyword">
					<label class="listora-sr-only" for="listora-q">{S.directory.searchLabel}</label>
					<svg class="listora-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.3-4.3"></path>
					</svg>
					<input
						id="listora-q"
						class="listora-input listora-search__input"
						type="search"
						name="q"
						value={q}
						placeholder={S.directory.searchPlaceholder}
						autocomplete="off"
					/>
					<button class="listora-search__clear" type="button" id="listora-clear" hidden={q === ""} aria-label={S.directory.clearSearch}>
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M18 6 6 18"></path>
							<path d="m6 6 12 12"></path>
						</svg>
					</button>
				</div>
				<div class="listora-search__field listora-search__field--location" id="listora-location-field" hidden={!typeHasPlace}>
					<label class="listora-sr-only" for="listora-location">{S.directory.locationLabel}</label>
					<svg class="listora-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
						<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
						<circle cx="12" cy="10" r="3"></circle>
					</svg>
					<input
						id="listora-location"
						class="listora-input listora-search__input"
						type="text"
						name="location"
						value={location}
						placeholder={S.directory.locationPlaceholder}
						autocomplete="off"
					/>
				</div>
				<button class="listora-btn listora-search__submit" type="submit">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<path d="m21 21-4.3-4.3"></path>
					</svg>
					<span>{S.directory.search}</span>
				</button>
			</div>
			{(typeChips.length > 1 || type) && (
			<div class="listora-chips" id="listora-types">
				<a class:list={{ "listora-chip": true, "is-active": !type }} href="/listings/">{S.directory.all}</a>
				{
					typeChips.map((item) => (
						<a
							class:list={{ "listora-chip": true, "is-active": type === item.slug }}
							href={`/listings/?type=${item.slug}`}
							data-type={item.slug}
							data-place={item.location === false ? "0" : "1"}
						>
							{item.name}
						</a>
					))
				}
			</div>
			)}
			{category ? <input type="hidden" name="category" value={category} /> : null}
		</form>

		<div id="listora-facets-slot">
		{
			categoryFacets.length > 0 || (cityFacets.length > 1 || (city && cityFacets.length > 0)) ? (
				<nav class="listora-facets" aria-label={S.directory.browse}>
					{categoryFacets.length > 0 ? (
						<div class="listora-facets__row">
							<h2 class="listora-meta" id="facet-category">{S.directory.category}</h2>
							<ul class="listora-chips" aria-labelledby="facet-category">
								{categoryFacets.map((item) => (
									<li>
										<a
											class:list={{ "listora-chip": true, "is-active": category === item.slug }}
											href={facetHref("category", category === item.slug ? "" : item.slug)}
											aria-current={category === item.slug ? "true" : undefined}
											data-facet
										>
											{item.label} {item.count && !type ? <span class="listora-chip__count">{item.count}</span> : null}
											</a>
											</li>
											))}
							</ul>
						</div>
					) : null}
					{(cityFacets.length > 1 || (city && cityFacets.length > 0)) ? (
						<div class="listora-facets__row">
							<h2 class="listora-meta" id="facet-city">{S.directory.city}</h2>
							<ul class="listora-chips" aria-labelledby="facet-city">
								{cityFacets.map((item) => {
								const on = city.toLowerCase() === item.toLowerCase();
									return (
										<li>
											<a
												class:list={{ "listora-chip": true, "is-active": on }}
												href={facetHref("city", on ? "" : item)}
												aria-current={on ? "true" : undefined}
												data-facet
											>
												{item}
											</a>
										</li>
									);
								})}
							</ul>
						</div>
					) : null}
				</nav>
			) : null
		}

		</div>

		<div id="listora-featured-slot">
		{
			featuredEntries.length ? (
				<section class="listora-featured" aria-label={S.directory.featuredLabel}>
					<h2 class="listora-meta">{S.common.featured}</h2>
					<div class="listora-featured__track">
						{featuredEntries.map((listing) => (
							<article class="listora-card">
								<div class="listora-card-media">
									{listing.data.featured_image ? (
										<Image image={listing.data.featured_image} alt="" />
									) : (
										<Fragment set:html={placeholderHtml(typeOf(types, listing.data.listing_type))} />
									)}
									<span class="listora-badge">{typeName(listing.data.listing_type)}</span>
									<span class="listora-badge listora-badge--featured">{S.common.featured}</span>
								</div>
								<div class="listora-card-body">
									<h3>
										<a href={`/listings/${listing.id}/`}>{listing.data.title}</a>
									</h3>
									<p class="listora-meta">{placeFor(types, listing.data)}</p>
								</div>
							</article>
						))}
					</div>
				</section>
			) : null
		}
		</div>

		<div class="listora-toolbar">
			<div id="listora-toolbar-count">{total === null ? "" : resultCount(total)}</div>
			<div class="listora-toolbar__actions">
				{/* Keyword results come best match first, so there is no sort to pick while searching. */}
				<div id="listora-sort-slot" hidden={searching}>
					<label class="listora-sr-only" for="listora-sort">{S.directory.sort}</label>
					<select class="listora-sort" id="listora-sort" name="sort">
						<option value="featured" selected={sort === "featured"}>{S.common.featured}</option>
						<option value="rating" selected={sort === "rating"}>{S.directory.rating}</option>
						<option value="title" selected={sort === "title"}>{S.directory.titleSort}</option>
						{slotSorts.map((item) => <option value={item.value} selected={sort === item.value}>{item.label}</option>)}
					</select>
				</div>
				<div class="listora-view-toggle" id="listora-view-toggle">
					<a class:list={{ "is-active": view !== "list" }} href={link({ ...here, view: "grid" })}>{S.directory.grid}</a>
					<a class:list={{ "is-active": view === "list" }} href={link({ ...here, view: "list" })}>{S.directory.list}</a>
				</div>
				<a class="listora-btn listora-btn--ghost" href="/listings/calendar/">{S.directory.calendar}</a>
			</div>
		</div>

		<div id="listora-results" class:list={{ "listora-grid": true, "is-list": view === "list" }}>
			{
				shown.length === 0 && featuredEntries.length === 0 ? (
					<div class="listora-empty">
						<div class="listora-empty__icon" aria-hidden="true">
							<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="m21 21-4.3-4.3"></path>
							</svg>
						</div>
						{/* Empty, nothing found, or not readable just now: say which it is. */}
						<h2>{failed ? S.directory.unavailableTitle : plain && total === 0 ? S.directory.noneYetTitle : S.directory.emptyTitle}</h2>
						<p>{failed || (plain && total === 0 ? S.directory.noneYetBody : S.directory.emptyBody)}</p>
						{failed ? null : <a class="listora-btn" href="/listings/submit/">{S.directory.add}</a>}
					</div>
				) : (
					shown.map((listing) => {
						const located = hasPlace(types, listing.data.listing_type);
						const hours = located ? parseHours(listing.data.hours) : [];
						const open = hours.length ? isOpenNow(hours, zone) : null;
						const amenities = amenityList(listing.data.amenities);
						const owner = String(listing.data.owner_name || "");
						const listingType = typeOf(types, listing.data.listing_type);
						const facts = cardFacts(listing.data, listingType, settings?.dateFormat);
						// Software has a card of its own: what it is, what it works with, its license, price, stars and last release.
						const sw = isSoftware(listingType) ? softwareView(listing.data, listingType) : null;
						const badges = sw ? [sw.kind, sw.worksWith, sw.license, sw.price].filter(Boolean) : [];
						return (
							<article class="listora-card" data-slug={listing.id} data-type={listing.data.listing_type} data-city={located ? listing.data.city : undefined} data-lat={located ? listing.data.lat : undefined} data-lng={located ? listing.data.lng : undefined}>
								<div class="listora-card-media">
									{listing.data.featured_image ? (
										<Image image={listing.data.featured_image} alt="" />
									) : (
										<Fragment set:html={placeholderHtml(typeOf(types, listing.data.listing_type))} />
									)}
									<span class="listora-badge">{typeName(listing.data.listing_type)}</span>
									{listing.data.is_featured ? <span class="listora-badge listora-badge--featured">{S.common.featured}</span> : null}
									<span class="listora-card__rating" data-rating={listing.data.id} hidden></span>
									<button class="listora-card__favorite" type="button" data-favorite={listing.data.id} aria-pressed="false" aria-label={saveNamed(String(listing.data.title || ""))}>
										<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
											<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
										</svg>
									</button>
								</div>
								<div class="listora-card-body">
									<h2>
										<a href={`/listings/${listing.id}/`}>{listing.data.title}</a>
									</h2>
									<p class="listora-meta">
										<span>{placeFor(types, listing.data)}</span>
										{open === true ? <span class="listora-open">{S.common.open}</span> : null}
										{open === false ? <span class="listora-closed">{S.common.closed}</span> : null}
									</p>
									{owner ? <p class="listora-meta">{sw ? S.software.maintainedBy : S.directory.listedBy} {owner}</p> : null}
									{sw ? (
										<>
											{listing.data.excerpt ? <p class="listora-software__summary">{listing.data.excerpt}</p> : null}
											{badges.length ? (
												<ul class="listora-software__badges" aria-label={S.software.badges}>
													{badges.map((badge) => <li class="listora-chip">{badge}</li>)}
												</ul>
											) : null}
											<p class="listora-software__meta" data-gh={sw.github || undefined}>
												<span data-gh-wrap hidden={sw.stars === null}>
													<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
													<span data-gh-stars>{sw.stars === null ? "" : countLabel(sw.stars)}</span>
													<span class="listora-sr-only">{S.software.stars}</span>
												</span>
												{sw.version || sw.lastRelease ? (
													<span>
														{sw.version ? <span data-gh-version>{sw.version}</span> : null}
														{sw.lastRelease ? <time datetime={sw.lastRelease} data-relative>{relativeTime(sw.lastRelease)}</time> : null}
													</span>
												) : null}
											</p>
											{sw.repository ? (
												<p>
													<a class="listora-btn listora-btn--secondary listora-software__repo" href={sw.repository} rel={listing.data.is_claimed ? "nofollow ugc" : undefined}>
														{sw.github ? S.software.viewOnGithub : S.software.repository}
													</a>
												</p>
											) : null}
										</>
									) : null}
									{!sw && facts.length ? (
										<p class="listora-card__features">
											{facts.map((fact) => <span>{fact}</span>)}
										</p>
									) : null}
									{amenities.length ? (
										<p class="listora-card__features">
											{amenities.map((item) => <span>{item}</span>)}
										</p>
									) : null}
									{!sw && listing.data.excerpt ? <p>{listing.data.excerpt}</p> : null}
								</div>
							</article>
						);
					})
				)
			}
		</div>

		<div id="listora-pager-slot">
		{
			page > 1 || nextHref ? (
			<nav class="listora-pager" id="listora-pager" aria-label={S.directory.pages}>
			{page > 1 ? <a class="listora-btn listora-btn--secondary" rel="prev" href={prevHref}>{S.common.previous}</a> : <span></span>}
			<span class="listora-pager__status">{pages ? pageOf(page, pages) : pageNumber(page)}</span>
			{nextHref ? <a class="listora-btn listora-btn--secondary" rel="next" href={nextHref}>{S.common.next}</a> : <span></span>}
				</nav>
			) : null
		}
		</div>

		<div class="listora-skeletons" aria-hidden="true">
			<div class="listora-skeleton"></div>
			<div class="listora-skeleton"></div>
			<div class="listora-skeleton"></div>
		</div>

		<div id="listora-map" class="listora-map" hidden></div>
	</div>
</Layout>

<link rel="stylesheet" href="/vendor/leaflet/leaflet.css" />
<script>
	import { api, esc, goSignIn, liveGithub, savedIds } from "../../lib/listora";
	import { rated, S } from "../../lib/listora-strings";

	const form = document.getElementById("listora-search-form") as HTMLFormElement | null;
	const q = document.getElementById("listora-q") as HTMLInputElement | null;
	const locationInput = document.getElementById("listora-location") as HTMLInputElement | null;
	const sortValue = () => (document.getElementById("listora-sort") as HTMLSelectElement | null)?.value || "featured";
	const results = document.getElementById("listora-results");
	const mapEl = document.getElementById("listora-map");
	const clearBtn = document.getElementById("listora-clear") as HTMLButtonElement | null;
	let activeType = new URLSearchParams(location.search).get("type") || "";
	const activeCategory = new URLSearchParams(location.search).get("category") || "";
	const activeCity = new URLSearchParams(location.search).get("city") || "";

	// The parts of the page a search changes. Live search loads this same page for the new
	// query and swaps them in, so there is one way a card is drawn: the server's.
	const LIVE = ["listora-count", "listora-facets-slot", "listora-featured-slot", "listora-toolbar-count", "listora-sort-slot", "listora-view-toggle", "listora-results", "listora-pager-slot"];

	function searchUrl(extra: Record<string, string> = {}): string {
		const params = new URLSearchParams({
			...(q?.value ? { q: q.value } : {}),
			...(locationInput?.value ? { location: locationInput.value } : {}),
			...(activeType ? { type: activeType } : {}),
			...(activeCategory ? { category: activeCategory } : {}),
			...(activeCity && !locationInput?.closest("[hidden]") ? { city: activeCity } : {}),
			...(sortValue() !== "featured" ? { sort: sortValue() } : {}),
			...(new URLSearchParams(location.search).get("view") === "list" ? { view: "list" } : {}),
			...extra,
		});
		const query = params.toString();
		return query ? `/listings/?${query}` : "/listings/";
	}

	let latest = 0;
	async function runSearch() {
		if (!results || !form) return;
		const url = searchUrl();
		const mine = ++latest;
		form.classList.add("is-busy");
		form.setAttribute("aria-busy", "true");
		let next: Document | null = null;
		try {
			const response = await fetch(url, { headers: { Accept: "text/html" } });
			if (response.ok) next = new DOMParser().parseFromString(await response.text(), "text/html");
		} catch {
			next = null;
		}
		// A slower, older answer must not replace a newer one.
		if (mine !== latest) return;
		form.classList.remove("is-busy");
		form.removeAttribute("aria-busy");
		if (clearBtn) clearBtn.hidden = !(q?.value || "");
		if (!next?.getElementById("listora-results")) {
			results.innerHTML =
				`<div class="listora-empty" role="alert"><h2>${esc(S.directory.searchDownTitle)}</h2><p>${esc(S.directory.searchDownBody)}</p></div>`;
			return;
		}
		for (const id of LIVE) {
			const from = next.getElementById(id);
			const to = document.getElementById(id);
			if (!from || !to) continue;
			to.innerHTML = from.innerHTML;
			if (id === "listora-results") to.className = from.className;
			if (id === "listora-sort-slot") to.hidden = from.hidden;
		}
		history.replaceState(null, "", url);
		fillRatings();
		drawMap();
		askSaved();
		liveGithub();
	}
	// Back and forward bring the matching page.
	window.addEventListener("popstate", () => location.reload());

	// Ratings are not in the page HTML: they come from plugin storage in one request.
	async function fillRatings() {
		const slots = [...document.querySelectorAll<HTMLElement>("[data-rating]")];
		const ids = [...new Set(slots.map((node) => node.dataset.rating ?? ""))].filter(Boolean).slice(0, 80);
		if (!ids.length) return;
		const data = await api(`ratings?ids=${encodeURIComponent(ids.join(","))}`);
		const ratings = (data.ratings ?? {}) as Record<string, { average: number; count: number }>;
		slots.forEach((node) => {
			const rating = ratings[node.dataset.rating ?? ""];
			if (!rating) return;
			node.hidden = false;
			node.textContent = `${"★".repeat(Math.max(1, Math.round(rating.average)))} ${rating.average.toFixed(1)}`;
			node.setAttribute("aria-label", rated(rating.average.toFixed(1), rating.count));
		});
	}
	fillRatings();
	// Software cards on github.com: live stars from GitHub, in the visitor's browser. The stored number stays if that fails.
	liveGithub();

	q?.addEventListener("input", () => {
		if (clearBtn) clearBtn.hidden = !q.value;
		window.clearTimeout((q as HTMLInputElement & { t?: number }).t);
		(q as HTMLInputElement & { t?: number }).t = window.setTimeout(() => runSearch(), 280);
	});

	locationInput?.addEventListener("input", () => {
		window.clearTimeout((locationInput as HTMLInputElement & { t?: number }).t);
		(locationInput as HTMLInputElement & { t?: number }).t = window.setTimeout(() => runSearch(), 280);
	});

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		runSearch();
	});

	clearBtn?.addEventListener("click", () => {
		if (q) q.value = "";
		runSearch();
		q?.focus();
	});

	// The sort list is drawn again with each search (a type brings its own sorts), so listen on its slot.
	document.getElementById("listora-sort-slot")?.addEventListener("change", () => runSearch());

	document.getElementById("listora-types")?.addEventListener("click", (event) => {
		const link = (event.target as HTMLElement).closest("a[data-type], a.listora-chip");
		if (!link) return;
		event.preventDefault();
		activeType = (link as HTMLElement).dataset.type || "";
		// A type without a location has no city to search by.
		const field = document.getElementById("listora-location-field");
		const placeless = (link as HTMLElement).dataset.place === "0";
		if (field) field.hidden = placeless;
		if (placeless && locationInput) locationInput.value = "";
		document.querySelectorAll("#listora-types .listora-chip").forEach((chip) => chip.classList.remove("is-active"));
		link.classList.add("is-active");
		runSearch();
	});

	// The page is the same for every visitor, so which hearts are on is asked after it loads, for
	// the cards on the page. Cards a search draws later are asked about when they appear.
	let saved = new Set<string>();
	const asked = new Set<string>();
	const askSaved = async () => {
		const ids = [...document.querySelectorAll<HTMLButtonElement>("[data-favorite]")].map((button) => button.dataset.favorite || "").filter((id) => id && !asked.has(id));
		if (!ids.length) return markSaved();
		ids.forEach((id) => asked.add(id));
		for (const id of await savedIds(ids)) saved.add(id);
		markSaved();
	};
	const markSaved = () =>
		document.querySelectorAll<HTMLButtonElement>("[data-favorite]").forEach((button) => {
			const on = saved.has(button.dataset.favorite || "");
			button.classList.toggle("is-on", on);
			button.setAttribute("aria-pressed", String(on));
		});
	askSaved();

	results?.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-favorite]");
		if (!button) return;
		event.preventDefault();
		const listingId = button.dataset.favorite;
		if (!listingId) return;
		const on = button.classList.contains("is-on");
		const result = await api("favorites", { listingId }, on ? "DELETE" : "POST");
		if (!result.ok) {
			if (result.error?.code === "SIGN_IN_REQUIRED") goSignIn();
			return;
		}
		if (on) saved.delete(listingId);
		else saved.add(listingId);
		markSaved();
	});

	// The map follows whatever cards are on the page, including after a live search.
	type Leaflet = { map: Function; tileLayer: Function; marker: Function; layerGroup: Function };
	let map: { setView: Function } | null = null;
	let markers: { clearLayers: Function; addLayer: Function } | null = null;
	function drawMap() {
		if (!mapEl) return;
		const points = [...document.querySelectorAll<HTMLElement>("#listora-results [data-lat]")].flatMap((node) => {
			const lat = Number(node.dataset.lat);
			const lng = Number(node.dataset.lng);
			if (!node.dataset.lat || !Number.isFinite(lat) || !Number.isFinite(lng)) return [];
			return [{ lat, lng, title: node.querySelector("h2")?.textContent ?? "" }];
		});
		mapEl.hidden = points.length === 0;
		if (!points.length) return;
		const place = (L: Leaflet) => {
			if (!map) {
				map = L.map(mapEl);
				L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", { attribution: `&copy; ${esc(S.directory.mapCredit)}` }).addTo(map);
				markers = L.layerGroup().addTo(map);
			}
			markers?.clearLayers();
			for (const point of points) {
				// A text node, never a string: Leaflet puts a string popup in as HTML, and the title is member-written.
				const popup = document.createElement("span");
				popup.textContent = point.title;
				markers?.addLayer(L.marker([point.lat, point.lng]).bindPopup(popup));
			}
			map?.setView([points[0].lat, points[0].lng], 12);
		};
		const ready = (window as unknown as { L?: Leaflet }).L;
		if (ready) return place(ready);
		if (document.getElementById("listora-leaflet")) return;
		const leaflet = document.createElement("script");
		leaflet.id = "listora-leaflet";
		leaflet.src = "/vendor/leaflet/leaflet.js";
		leaflet.onload = () => drawMap();
		document.body.append(leaflet);
	}
	drawMap();
</script>
