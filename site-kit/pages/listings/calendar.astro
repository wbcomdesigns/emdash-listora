---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Layout from "../../layouts/ListoraLayout.astro";
import { formatEventWhen, siteZone } from "../../lib/listora";
import { eventCount, S } from "../../lib/listora-strings";
import "../../styles/listora-ui.css";

const { entries, cacheHint } = await getEmDashCollection("listings", {
	limit: 80,
	where: { listing_type: "event" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const zone = siteZone((await getSiteSettings())?.timezone);
// "Today" in the site's zone, so an event tonight is not dropped early.
const today = new Intl.DateTimeFormat("en-CA", { timeZone: zone }).format(new Date());
const events = entries
	.filter((entry) => String(entry.data.event_end || entry.data.event_start || "").slice(0, 10) >= today)
	.sort((a, b) => String(a.data.event_start).localeCompare(String(b.data.event_start)));
---

<Layout title={S.calendar.title} description={S.calendar.description}>
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>{S.calendar.heading}</h1>
				<p>{eventCount(events.length)}</p>
			</div>
			<a class="listora-btn listora-btn--ghost" href="/listings/">{S.calendar.directory}</a>
		</header>
		{
			events.length === 0 ? (
				<div class="listora-empty">
					<h2>{S.calendar.emptyTitle}</h2>
					<p>{S.calendar.emptyBody}</p>
					<a class="listora-btn" href="/listings/submit/">{S.calendar.add}</a>
				</div>
			) : (
				<div class="listora-grid is-list">
					{events.map((event) => (
						<article class="listora-card">
							<div class="listora-card-body">
								<p class="listora-meta">{formatEventWhen(event.data.event_start, zone)}</p>
								<h2>
									<a href={`/listings/${event.id}/`}>{event.data.title}</a>
								</h2>
								<p>{event.data.city}</p>
							</div>
						</article>
					))}
				</div>
			)
		}
	</div>
</Layout>
