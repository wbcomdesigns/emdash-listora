---
import { getTaxonomyTerms } from "emdash";
import Layout from "../../layouts/ListoraLayout.astro";
import { jsonForScript, loadTypes, typeHint } from "../../lib/listora";
import { S } from "../../lib/listora-strings";
import "../../styles/listora-ui.css";

// This page differs per visitor. Sites cache pages without regard to cookies, so say so.
Astro.response.headers.set("Cache-Control", "private, no-store");
const user = Astro.locals.user;
// The site's own categories. A site with none still gets a working form.
const categories = await getTaxonomyTerms("listing_category").catch(() => []);
// The types as the owner has set them up in the admin. Hidden ones are not offered for a new listing,
// but an owner editing a listing of a hidden type still sees its card and its fields.
const types = user ? await loadTypes(Astro.locals) : [];
const firstShown = types.find((item) => !item.hidden)?.slug;
// What the form needs to draw each type's own fields and to know whether it has a place.
const typeData = types.map((item) => ({ slug: item.slug, location: item.location !== false, fields: item.fields ?? [] }));
const loginUrl = `/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname)}`;
---

<Layout title={S.submit.title} description={S.submit.description}>
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1 id="wizard-title">{S.submit.heading}</h1>
				<p id="wizard-intro">{S.submit.intro}</p>
			</div>
			<a class="listora-btn listora-btn--ghost" id="wizard-back" href="/listings/">{S.submit.backAll}</a>
		</header>

		{
			user ? null : (
				<div class="listora-empty">
					<h2>{S.submit.signInTitle}</h2>
					<p>{S.submit.signInBody}</p>
					<a class="listora-btn" href={loginUrl}>{S.common.signIn}</a>
				</div>
			)
		}
		{user ? (
		<Fragment>
		<ol class="listora-wizard-steps" id="wizard-steps">
			<li><button type="button" data-step="1" aria-current="step">{S.submit.stepType}</button></li>
			<li><button type="button" data-step="2">{S.submit.stepBasics}</button></li>
			<li><button type="button" data-step="3">{S.submit.stepDetails}</button></li>
			<li><button type="button" data-step="4">{S.submit.stepCategories}</button></li>
			<li><button type="button" data-step="5">{S.submit.stepPreview}</button></li>
		</ol>

		<div id="listora-status" class="listora-status" role="status" aria-live="polite" hidden></div>
		<p id="dup-warning" class="listora-status" data-tone="error" hidden></p>

		<form id="listora-submit" class="listora-form" novalidate>
			<div class="listora-honeypot">
				<label>{S.common.companyWebsite}<input name="company_website" tabindex="-1" autocomplete="off" /></label>
			</div>

			<section class="listora-form-section" data-panel="1">
				<h2>{S.submit.what}</h2>
				<p class="listora-helper" id="type-help">{S.submit.typeHelp}</p>
				<div class="listora-type-grid" role="radiogroup" aria-labelledby="type-help">
					{
						types.map((item) => (
							<label class="listora-type-card" hidden={item.hidden} data-hidden-type={item.hidden ? "" : undefined}>
								<input
									type="radio"
									name="listing_type"
									value={item.slug}
									checked={item.slug === firstShown}
									disabled={item.hidden}
								/>
								<span class="listora-type-card__name">{item.name}</span>
								{typeHint(item.slug) ? <span class="listora-type-card__hint">{typeHint(item.slug)}</span> : null}
							</label>
						))
					}
				</div>
			</section>

			<section class="listora-form-section" data-panel="2" hidden>
				<h2>{S.submit.stepBasics}</h2>
				<p class="listora-helper">{S.submit.basicsHelp}</p>
				<div class="listora-field">
					<label class="listora-label" for="title">
						{S.submit.titleLabel} <span class="listora-req">{S.common.required}</span>
					</label>
					<input
						id="title"
						class="listora-input"
						name="title"
						maxlength="200"
						required
						autocomplete="organization"
						aria-required="true"
						aria-describedby="title-help title-error"
					/>
					<p class="listora-helper" id="title-help">{S.submit.titleHelp}</p>
					<p class="listora-field-error" id="title-error" hidden>{S.submit.titleError}</p>
				</div>
				<div class="listora-field">
					<label class="listora-label" for="excerpt">{S.submit.summary}</label>
					<textarea id="excerpt" class="listora-input" name="excerpt" rows="2" maxlength="280" aria-describedby="excerpt-help"></textarea>
					<p class="listora-helper" id="excerpt-help">{S.submit.summaryHelp}</p>
				</div>
				<div class="listora-field">
					<label class="listora-label" for="description">{S.submit.descriptionLabel}</label>
					<textarea id="description" class="listora-input" name="description" rows="5" aria-describedby="description-help"></textarea>
					<p class="listora-helper" id="description-help">{S.submit.descriptionHelp}</p>
				</div>
				<div class="listora-form-grid" data-place>
					<div class="listora-field">
						<label class="listora-label" for="city">{S.submit.city}</label>
						<input id="city" class="listora-input" name="city" autocomplete="address-level2" />
					</div>
					<div class="listora-field">
						<label class="listora-label" for="address">{S.submit.address}</label>
						<input id="address" class="listora-input" name="address" autocomplete="street-address" />
					</div>
				</div>
			</section>

			<section class="listora-form-section" data-panel="3" hidden>
				<h2>{S.submit.stepDetails}</h2>
				<p class="listora-helper">{S.submit.detailsHelp}</p>
				<div class="listora-form-grid">
					<div class="listora-field">
						<label class="listora-label" for="phone">{S.submit.phone}</label>
						<input id="phone" class="listora-input" name="phone" type="tel" autocomplete="tel" />
					</div>
					<div class="listora-field">
						<label class="listora-label" for="email">{S.submit.email}</label>
						<input id="email" class="listora-input" name="email" type="email" autocomplete="email" />
					</div>
				</div>
				<div class="listora-field">
					<label class="listora-label" for="website">{S.submit.website}</label>
					<input id="website" class="listora-input" name="website" type="url" aria-describedby="website-help" />
					<p class="listora-helper" id="website-help">{S.submit.websiteHelp}</p>
				</div>
				<div class="listora-form-grid">
					<div class="listora-field">
						<label class="listora-label" for="owner_name">{S.submit.listedBy}</label>
						<input id="owner_name" class="listora-input" name="owner_name" />
					</div>
					<div class="listora-field" data-place>
						<label class="listora-label" for="amenities">{S.submit.amenities}</label>
						<input id="amenities" class="listora-input" name="amenities" aria-describedby="amenities-help" />
						<p class="listora-helper" id="amenities-help">{S.submit.amenitiesHelp}</p>
					</div>
				</div>
				<div id="type-fields"></div>
			</section>

			<section class="listora-form-section" data-panel="4" hidden>
				<h2>{S.submit.stepCategories}</h2>
				<p class="listora-helper">{S.submit.categoriesHelp}</p>
				<div class="listora-field">
					<label class="listora-label" for="category">{S.submit.category}</label>
					<select id="category" class="listora-input" name="category">
						<option value="">{S.submit.noCategory}</option>
						{categories.map((term) => <option value={term.slug}>{term.label}</option>)}
					</select>
				</div>
				<div class="listora-form-grid" data-place>
					<div class="listora-field">
						<label class="listora-label" for="country">{S.submit.country}</label>
						<input id="country" class="listora-input" name="country" autocomplete="country" />
					</div>
					<div class="listora-field">
						<label class="listora-label" for="state">{S.submit.state}</label>
						<input id="state" class="listora-input" name="state" autocomplete="address-level1" />
					</div>
				</div>
			</section>

			<section class="listora-form-section" data-panel="5" hidden>
				<h2>{S.submit.stepPreview}</h2>
				<p class="listora-helper">{S.submit.previewHelp}</p>
				<div id="preview"></div>
				<div class="listora-field">
					<div class="listora-check">
						<input id="agree_terms" name="agree_terms" type="checkbox" value="true" aria-describedby="agree-error" />
						<label class="listora-label" for="agree_terms">{S.submit.agree}</label>
					</div>
					<p class="listora-field-error" id="agree-error" hidden>{S.submit.agreeError}</p>
				</div>
			</section>

			<div class="listora-actions">
				<button class="listora-btn listora-btn--ghost" type="button" id="back-btn" hidden>{S.submit.back}</button>
				<button class="listora-btn" type="button" id="next-btn">{S.submit.continue}</button>
				<button class="listora-btn" type="submit" id="submit-btn" hidden>{S.submit.send}</button>
			</div>
		</form>
		<script type="application/json" id="listora-type-data" set:html={jsonForScript(typeData)} />
		</Fragment>
		) : null}
	</div>
</Layout>

<script>
	import { api, esc, type TypeFieldInfo } from "../../lib/listora";
	import { fieldHelp, S } from "../../lib/listora-strings";

	const form = document.getElementById("listora-submit") as HTMLFormElement | null;
	if (form) wizard(form);

	function wizard(form: HTMLFormElement) {
	let step = 1;
	type TypeData = { slug: string; location: boolean; fields: TypeFieldInfo[] };
	const typeData: TypeData[] = (() => {
		try {
			return JSON.parse(document.getElementById("listora-type-data")?.textContent || "[]");
		} catch {
			return [];
		}
	})();
	const chosenType = (): TypeData => {
		const slug = String(new FormData(form).get("listing_type") || "");
		return typeData.find((item) => item.slug === slug) ?? { slug, location: true, fields: [] };
	};
	const PLACE_KEYS = ["address", "city", "state", "country"];
	// /listings/submit/?edit=<listing> opens the same form for a listing the member already owns.
	const editId = new URLSearchParams(location.search).get("edit") || "";
	function setFieldError(id: string, errorId: string, show: boolean) {
		const input = document.getElementById(id) as HTMLInputElement | null;
		const error = document.getElementById(errorId);
		input?.classList.toggle("is-invalid", show);
		input?.setAttribute("aria-invalid", show ? "true" : "false");
		if (error) error.hidden = !show;
		if (show) input?.focus();
	}

	function showStep(next: number) {
		step = next;
		form.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
			panel.hidden = Number(panel.dataset.panel) !== step;
		});
		document.querySelectorAll<HTMLButtonElement>("#wizard-steps button").forEach((node) => {
			if (Number(node.dataset.step) === step) node.setAttribute("aria-current", "step");
			else node.removeAttribute("aria-current");
		});
		// Say where we are: focus lands on the new step's heading, which a screen reader then reads.
		const heading = form.querySelector<HTMLElement>(`[data-panel="${step}"] h2`);
		if (heading) {
			heading.tabIndex = -1;
			heading.focus();
		}
		(document.getElementById("back-btn") as HTMLButtonElement).hidden = step === 1;
		(document.getElementById("next-btn") as HTMLButtonElement).hidden = step === 5;
		(document.getElementById("submit-btn") as HTMLButtonElement).hidden = step !== 5;
		if (step === 5) renderPreview();
	}

	/** One of the type's own fields, with the input its kind needs. Every owner-written word is escaped. */
	function fieldHtml(field: TypeFieldInfo): string {
		const id = `tf-${field.key}`;
		const help = fieldHelp(chosenType().slug, field.key);
		const required = field.required ? ` required aria-required="true"` : "";
		const marker = field.required ? ` <span class="listora-req">${esc(S.common.required)}</span>` : "";
		const described = help ? ` aria-describedby="${id}-help"` : "";
		const helpHtml = help ? `<p class="listora-helper" id="${id}-help">${esc(help)}</p>` : "";
		// A required yes or no is a Yes or No choice: a ticked box would be the only answer a required box allows.
		if (field.kind === "yesno" && field.required) {
			return `<div class="listora-field"><label class="listora-label" for="${id}">${esc(field.label)}${marker}</label><select id="${id}" class="listora-input" name="${id}"${required}${described}><option value="">${esc(S.common.choose)}</option><option value="true">${esc(S.common.yes)}</option><option value="false">${esc(S.common.no)}</option></select>${helpHtml}</div>`;
		}
		if (field.kind === "yesno") {
			return `<div class="listora-field"><div class="listora-check"><input id="${id}" name="${id}" type="checkbox" value="true"${required}${described} /><label class="listora-label" for="${id}">${esc(field.label)}${marker}</label></div>${helpHtml}</div>`;
		}
		const label = `<label class="listora-label" for="${id}">${esc(field.label)}${marker}</label>`;
		const input =
			field.kind === "choice"
				? `<select id="${id}" class="listora-input" name="${id}"${required}${described}><option value="">${esc(S.common.choose)}</option>${(field.options ?? []).map((option) => `<option value="${esc(option)}">${esc(option)}</option>`).join("")}</select>`
				: `<input id="${id}" class="listora-input" name="${id}" ${
						field.kind === "number"
							? 'type="number" step="any" inputmode="decimal"'
							: field.kind === "link"
								? 'type="url" maxlength="200" placeholder="https://"'
								: field.kind === "date"
									? 'type="date"'
									: 'type="text" maxlength="200"'
					}${required}${described} />`;
		return `<div class="listora-field">${label}${input}${helpHtml}</div>`;
	}

	function renderTypeFields() {
		const type = chosenType();
		const box = document.getElementById("type-fields");
		if (box) box.innerHTML = type.fields.map(fieldHtml).join("");
		// A type without a location asks for no address, city, state, country or amenities.
		form.querySelectorAll<HTMLElement>("[data-place]").forEach((node) => {
			node.hidden = !type.location;
		});
	}

	/** The chosen type's own fields as the form has them. */
	function typeFields(): Record<string, string | boolean> {
		const out: Record<string, string | boolean> = {};
		for (const field of chosenType().fields) {
			const input = form.elements.namedItem(`tf-${field.key}`);
			if (input instanceof HTMLInputElement && input.type === "checkbox") out[field.key] = input.checked;
			else if (input instanceof HTMLInputElement || input instanceof HTMLSelectElement) out[field.key] = input.value;
		}
		return out;
	}

	function renderPreview() {
		const data = Object.fromEntries(new FormData(form).entries());
		const preview = document.getElementById("preview");
		// The name shown on the chosen type's card, as the page drew it from the plugin's types.
		const typeLabel = form.querySelector('input[name="listing_type"]:checked')?.closest("label")?.querySelector(".listora-type-card__name")?.textContent || "";
		if (preview) {
			const place = chosenType().location ? `<p class="listora-meta">${esc(data.city || S.submit.cityMissing)}</p>` : "";
			preview.innerHTML = `<article class="listora-card"><div class="listora-card-body"><p class="listora-meta"><span class="listora-badge listora-badge--type">${esc(typeLabel)}</span></p><h2>${esc(data.title || S.submit.untitled)}</h2>${place}<p>${esc(data.excerpt || S.submit.noSummary)}</p></div></article>`;
		}
	}

	async function checkDuplicate(title: string) {
		const warning = document.getElementById("dup-warning");
		// When editing, the match would be the listing itself.
		if (editId || !warning || !title.trim()) return;
		const data = await api(`duplicate?title=${encodeURIComponent(title)}`);
		const matches = (data.matches ?? []) as Array<{ slug: string; title: string }>;
		warning.hidden = matches.length === 0;
		warning.innerHTML =
			matches.length === 0
				? ""
				: `${esc(S.submit.duplicateBefore)}<a href="/listings/${esc(matches[0].slug)}/">${esc(matches[0].title)}</a>${esc(S.submit.duplicateAfter)}`;
	}

	form.querySelectorAll<HTMLInputElement>('input[name="listing_type"]').forEach((input) => {
		input.addEventListener("change", renderTypeFields);
	});
	// While typing: the "Enter a title." error clears as soon as there is one, and the duplicate check
	// runs once typing pauses, not only when the field loses focus (#87).
	let dupTimer: ReturnType<typeof setTimeout> | undefined;
	document.getElementById("title")?.addEventListener("input", (event) => {
		const value = (event.target as HTMLInputElement).value;
		if (value.trim()) setFieldError("title", "title-error", false);
		clearTimeout(dupTimer);
		dupTimer = setTimeout(() => checkDuplicate(value), 600);
	});
	document.getElementById("title")?.addEventListener("blur", (event) => {
		clearTimeout(dupTimer);
		checkDuplicate((event.target as HTMLInputElement).value);
	});
	document.querySelectorAll<HTMLButtonElement>("#wizard-steps button").forEach((button) => {
		button.addEventListener("click", () => {
			const target = Number(button.dataset.step);
			if (target > 2 && !(document.getElementById("title") as HTMLInputElement).value.trim()) {
				showStep(2);
				setFieldError("title", "title-error", true);
				return;
			}
			showStep(target);
		});
	});
	document.getElementById("next-btn")?.addEventListener("click", () => {
		if (step === 2 && !(document.getElementById("title") as HTMLInputElement).value.trim()) {
			setFieldError("title", "title-error", true);
			return;
		}
		setFieldError("title", "title-error", false);
		// A field the browser can check (an email, a web address) is checked on its own step,
		// with the browser's own message next to it, not at the very end.
		const wrong = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(`[data-panel="${step}"] input, [data-panel="${step}"] select`)].find((input) => !input.checkValidity());
		if (wrong) {
			wrong.reportValidity();
			return;
		}
		showStep(Math.min(5, step + 1));
	});
	document.getElementById("back-btn")?.addEventListener("click", () => showStep(Math.max(1, step - 1)));
	renderTypeFields();
	if (editId) startEdit();

	async function startEdit() {
		const status = document.getElementById("listora-status");
		const data = await api(`edit?listingId=${encodeURIComponent(editId)}`);
		if (!data.ok) {
			// Not theirs, not public, or not found: say so and offer no form.
			form.hidden = true;
			document.getElementById("wizard-steps")?.setAttribute("hidden", "");
			if (status) {
				status.hidden = false;
				status.dataset.tone = "error";
				status.innerHTML = `${esc(data.error?.message || S.submit.editUnavailable)} <a href="/account/?tab=listings">${esc(S.submit.backListings)}</a>`;
			}
			return;
		}
		const values = (data.values ?? {}) as Record<string, unknown>;
		const title = document.getElementById("wizard-title");
		const intro = document.getElementById("wizard-intro");
		if (title) title.textContent = S.submit.editTitle;
		document.title = document.title.replace(S.submit.title, S.submit.editTitle);
		const back = document.getElementById("wizard-back") as HTMLAnchorElement | null;
		if (back) {
			back.textContent = S.submit.editBack;
			back.href = "/account/?tab=listings";
		}
		if (intro) {
			intro.textContent = data.pending ? S.submit.editPending : S.submit.editQuiet;
		}
		// The type of a live listing is fixed: pick it, lock the others, and start on Basics.
		form.querySelectorAll<HTMLInputElement>('input[name="listing_type"]').forEach((input) => {
			input.checked = input.value === data.listing_type;
			input.disabled = input.value !== data.listing_type;
			// A type the owner hid since: its card still shows, for this listing.
			if (input.checked) input.closest<HTMLElement>("label")?.removeAttribute("hidden");
		});
		renderTypeFields();
		const set = (name: string, value: unknown) => {
			const field = form.elements.namedItem(name);
			if (field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement || field instanceof HTMLSelectElement) {
				field.value = String(value ?? "");
			}
		};
		for (const [key, value] of Object.entries(values)) {
			if (key !== "type_fields") set(key, value);
			else
				for (const [inner, stored] of Object.entries((value ?? {}) as Record<string, unknown>)) {
					const field = form.elements.namedItem(`tf-${inner}`);
					if (field instanceof HTMLInputElement && field.type === "checkbox") field.checked = stored === true || stored === "true";
					else set(`tf-${inner}`, stored);
				}
		}
		// The category is set by the site's admin, so it is not part of an edit.
		document.getElementById("category")?.closest<HTMLElement>(".listora-field")?.setAttribute("hidden", "");
		const submit = document.getElementById("submit-btn");
		if (submit) submit.textContent = S.submit.editSend;
		showStep(2);
	}

	form.addEventListener("submit", async (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const title = String(data.get("title") ?? "").trim();
		if (!title) {
			showStep(2);
			setFieldError("title", "title-error", true);
			return;
		}
		if (data.get("agree_terms") !== "true") {
			showStep(5);
			setFieldError("agree_terms", "agree-error", true);
			return;
		}
		setFieldError("agree_terms", "agree-error", false);
		const status = document.getElementById("listora-status");
		const button = document.getElementById("submit-btn") as HTMLButtonElement;
		button.disabled = true;
		form.setAttribute("aria-busy", "true");
		try {
			const located = chosenType().location;
			const text = (name: string) => String(data.get(name) ?? "");
			const result = await api(editId ? "edit" : "submit", {
				...(editId ? { listingId: editId } : {}),
				title,
				listing_type: chosenType().slug,
				category: text("category"),
				excerpt: text("excerpt"),
				description: text("description"),
				phone: text("phone"),
				email: text("email"),
				website: text("website"),
				// Left out for a type without a location, so an edit keeps the address the listing has.
				...(located ? Object.fromEntries(PLACE_KEYS.map((key) => [key, text(key)])) : {}),
				owner_name: text("owner_name"),
				// A place's features (wifi, parking): not asked or sent for a type without a location.
				...(located ? { amenities: text("amenities") } : {}),
				agree_terms: data.get("agree_terms") === "true",
				company_website: text("company_website"),
				type_fields: typeFields(),
			});
			if (!result.ok) throw new Error(result.error?.message || S.submit.couldNot);
			// Done: the form and its steps go away, and the member reads what happens next where the
			// form was (an edit sent from the Preview step left the page looking unchanged).
			form.reset();
			form.hidden = true;
			const steps = document.getElementById("wizard-steps");
			if (steps) steps.hidden = true;
			if (status) {
				status.hidden = false;
				status.dataset.tone = "success";
				status.innerHTML = editId
					? `<p>${esc(result.unchanged ? S.submit.unchanged : S.submit.changesWaiting)}</p>` +
						`<div class="listora-actions"><a class="listora-btn" href="/account/?tab=listings">${esc(S.submit.backListings)}</a></div>`
					: `<p>${esc(result.pendingReview ? S.submit.thanksReview : S.submit.thanksLive)}</p>` +
						`<div class="listora-actions"><a class="listora-btn" href="/account/?tab=listings">${esc(S.submit.yourListings)}</a>` +
						`<a class="listora-btn listora-btn--secondary" href="/listings/submit/">${esc(S.submit.addAnother)}</a></div>`;
				status.tabIndex = -1;
				status.focus();
				status.scrollIntoView({ block: "center" });
			}
		} catch (error) {
			if (status) {
				status.hidden = false;
				status.dataset.tone = "error";
				status.textContent = error instanceof Error ? error.message : S.submit.couldNot;
			}
		} finally {
			button.disabled = false;
			form.removeAttribute("aria-busy");
		}
	});
	}
</script>
