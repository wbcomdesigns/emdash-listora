---
import Layout from "../../layouts/ListoraLayout.astro";
import { S } from "../../lib/listora-strings";
import "../../styles/listora-ui.css";

// This page differs per visitor. Sites cache pages without regard to cookies, so say so.
Astro.response.headers.set("Cache-Control", "private, no-store");
const user = Astro.locals.user as { role?: number } | undefined;
// The plugin refuses everyone but site admins on these routes; the page only mirrors that.
const isAdmin = Number(user?.role) >= 50;
const loginUrl = `/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname)}`;
---

<Layout title={S.transfer.title} description={S.transfer.description}>
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>{S.transfer.heading}</h1>
				<p>{S.transfer.intro}</p>
			</div>
		</header>
		{
			isAdmin ? (
				<div class="listora-transfer">
					<section class="listora-panel" aria-labelledby="export-title">
						<h2 id="export-title">{S.transfer.exportTitle}</h2>
						<p>{S.transfer.exportBody}</p>
						<button class="listora-btn" type="button" id="export-btn">{S.transfer.download}</button>
					</section>
					<section class="listora-panel" aria-labelledby="import-title">
						<h2 id="import-title">{S.transfer.importTitle}</h2>
						<p>
							{S.transfer.importLead} <a href="/vendor/listora-sample.csv" download>{S.transfer.sample}</a>
						</p>
						<form id="import-form" class="listora-form">
							<label class="listora-field">
								<span>{S.transfer.fileLabel}</span>
								<input type="file" id="import-file" accept=".csv,text/csv" required />
							</label>
							<button class="listora-btn" type="submit" id="check-btn">{S.transfer.check}</button>
						</form>
						<div id="import-result" aria-live="polite"></div>
					</section>
				</div>
			) : (
				<div class="listora-empty">
					<h2>{S.transfer.adminsTitle}</h2>
					<p>{S.transfer.adminsBody}</p>
					{user ? null : <a class="listora-btn" href={loginUrl}>{S.common.signIn}</a>}
				</div>
			)
		}
	</div>
</Layout>

<script>
	import { api, esc, listoraFetch, notify } from "../../lib/listora";
	import { importDrafts, importedDrafts, rowDup, rowLine, rowsCannot, rowsReady, rowsSkipped, S } from "../../lib/listora-strings";

	type Bad = { line: number; title: string; reason: string };
	type Dup = { line: number; title: string; city: string };

	const exportBtn = document.getElementById("export-btn") as HTMLButtonElement | null;
	exportBtn?.addEventListener("click", async () => {
		exportBtn.disabled = true;
		exportBtn.textContent = S.transfer.preparing;
		try {
			// A plain link cannot be used: the site only answers signed-in requests that carry this header.
			const response = await listoraFetch("export", { credentials: "same-origin", headers: { "X-EmDash-Request": "1" } });
			if (!response.ok) throw new Error();
			const blob = await response.blob();
			// The column names alone mean there was nothing to export.
			if ((await blob.text()).trim().split("\n").length < 2) {
				notify(exportBtn, { ok: false, error: { message: S.transfer.none } }, "");
				exportBtn.disabled = false;
				exportBtn.textContent = S.transfer.download;
				return;
			}
			const link = document.createElement("a");
			link.href = URL.createObjectURL(blob);
			link.download = /filename="([^"]+)"/.exec(response.headers.get("Content-Disposition") || "")?.[1] || "listings.csv";
			link.click();
			// Not at once: some browsers cancel a download whose address is withdrawn straight away.
			setTimeout(() => URL.revokeObjectURL(link.href), 2000);
			notify(exportBtn, { ok: true }, S.transfer.started);
		} catch {
			notify(exportBtn, { ok: false, error: { message: S.transfer.downloadFailed } }, "");
		}
		exportBtn.disabled = false;
		exportBtn.textContent = S.transfer.download;
	});

	const form = document.getElementById("import-form") as HTMLFormElement | null;
	const fileInput = document.getElementById("import-file") as HTMLInputElement | null;
	const checkBtn = document.getElementById("check-btn") as HTMLButtonElement | null;
	const out = document.getElementById("import-result");
	let csv = "";

	const rowsList = (title: string, items: string[]) =>
		items.length ? `<h3>${esc(title)}</h3><ul class="listora-transfer__rows">${items.map((item) => `<li>${item}</li>`).join("")}</ul>` : "";
	const skipped = (bad: Bad[], duplicates: Dup[]) =>
		rowsList(rowsCannot(bad.length), bad.map((row) => esc(rowLine(row.line, row.title, row.reason)))) +
		rowsList(rowsSkipped(duplicates.length), duplicates.map((row) => esc(rowDup(row.line, row.title, row.city))));
	const show = (tone: string, html: string) => {
		if (out) out.innerHTML = `<div class="listora-status" data-tone="${tone}">${html}</div>`;
	};
	const failed = (message?: string) => show("error", esc(message || S.common.fallback));

	fileInput?.addEventListener("change", () => {
		if (out) out.innerHTML = "";
	});

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const file = fileInput?.files?.[0];
		if (!file || !checkBtn) return;
		checkBtn.disabled = true;
		checkBtn.textContent = S.transfer.checking;
		// The site takes about 1 MB per request, and a file grows on the way. Say so here, in plain words.
		if (file.size > 600 * 1024) {
			checkBtn.disabled = false;
			checkBtn.textContent = S.transfer.check;
			return failed(S.transfer.tooBig);
		}
		csv = await file.text();
		const result = await api("import", { csv, mode: "check" });
		checkBtn.disabled = false;
		checkBtn.textContent = S.transfer.check;
		if (!result.ok) return failed(result.error?.message);
		const valid = Number(result.valid);
		const bad = (result.bad as Bad[]) || [];
		const duplicates = (result.duplicates as Dup[]) || [];
		show(
			valid ? "info" : "error",
			`<p><strong>${esc(rowsReady(valid, Number(result.total)))}</strong></p>` +
				skipped(bad, duplicates) +
				(valid ? `<button class="listora-btn" type="button" id="import-btn">${esc(importDrafts(valid))}</button>` : ""),
		);
		document.getElementById("import-btn")?.addEventListener("click", async (click) => {
			const button = click.currentTarget as HTMLButtonElement;
			button.disabled = true;
			button.textContent = S.transfer.importing;
			const done = await api("import", { csv, mode: "import" });
			if (!done.ok) return failed(done.error?.message);
			const count = Number(done.imported);
			form.reset();
			show(
				count ? "success" : "error",
				`<p><strong>${esc(importedDrafts(count))}</strong> ${esc(S.transfer.nothingLive)}</p>` +
					skipped((done.bad as Bad[]) || [], (done.duplicates as Dup[]) || []) +
					`<a class="listora-btn" href="/_emdash/admin/plugins/listora/queue">${esc(S.transfer.queue)}</a>`,
			);
		});
	});
</script>
