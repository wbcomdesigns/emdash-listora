---
import { getEmDashCollection } from "emdash";
import Base from "../../layouts/Base.astro";
import "../../styles/listora-ui.css";

const tab = Astro.url.searchParams.get("tab") || "overview";
const { entries } = await getEmDashCollection("listings", { limit: 80 });
const expired = entries.filter((entry) => entry.data.listing_status === "expired");
---

<Base title="Your listings" description="Owner dashboard for listings, reviews, claims, and favorites.">
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>Dashboard</h1>
				<p>Signed in as the demo member on this local lab.</p>
			</div>
			<a class="listora-btn" href="/listings/submit/">Add a listing</a>
		</header>
		<div class="listora-dash">
			<nav aria-label="Dashboard">
				<a class:list={{ "listora-chip": true, "is-active": tab === "overview" }} href="/account/">Overview</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "listings" }} href="/account/?tab=listings">My listings</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "reviews" }} href="/account/?tab=reviews">Reviews</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "claims" }} href="/account/?tab=claims">Claims</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "favorites" }} href="/account/?tab=favorites">Favorites</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "profile" }} href="/account/?tab=profile">Profile</a>
			</nav>
			<div id="dash-main" data-tab={tab} data-expired={expired[0]?.data.id ?? ""}>
				<section id="overview-panel">
					<div class="listora-chips" id="dash-counts"></div>
					{
						expired.length ? (
							<form class="listora-form-section" id="renew-form" data-id={expired[0].data.id}>
								<h2>Renew</h2>
								<p class="listora-helper">{expired[0].data.title} has expired. Renewing puts it back in review.</p>
								<div class="listora-actions">
									<button class="listora-btn" type="submit" id="renew-btn">Renew listing</button>
								</div>
								<p id="renew-status" class="listora-status" hidden></p>
							</form>
						) : null
					}
				</section>
				<section id="list-panel" hidden>
					<h2>My listings</h2>
					<div id="dash-listings"></div>
				</section>
				<section id="reviews-panel" hidden>
					<h2>Reviews</h2>
					<div id="dash-reviews"></div>
				</section>
				<section id="claims-panel" hidden>
					<h2>Claims</h2>
					<div id="dash-claims"></div>
				</section>
				<section id="fav-panel" hidden>
					<h2>Favorites</h2>
					<div id="dash-favs"></div>
				</section>
				<section id="profile-panel" hidden>
					<form class="listora-form-section" id="privacy-form">
						<h2>Profile and privacy</h2>
						<p class="listora-helper">Export demo-member reviews, claims, and favorites as JSON.</p>
						<div class="listora-actions">
							<button class="listora-btn" type="submit">Export my data</button>
						</div>
						<pre id="export-box" hidden></pre>
					</form>
				</section>
			</div>
		</div>
	</div>
</Base>

<script>
	const tab = document.getElementById("dash-main")?.getAttribute("data-tab") || "overview";
	const panels: Record<string, string> = {
		overview: "overview-panel",
		listings: "list-panel",
		reviews: "reviews-panel",
		claims: "claims-panel",
		favorites: "fav-panel",
		profile: "profile-panel",
	};
	Object.entries(panels).forEach(([key, id]) => {
		const node = document.getElementById(id);
		if (node) node.hidden = key !== tab;
	});

	async function load() {
		const response = await fetch("/_emdash/api/plugins/listora/dashboard?member_id=demo-member", {
			credentials: "same-origin",
			headers: { "X-EmDash-Request": "1" },
		});
		const json = await response.json();
		const data = json.data ?? {};
		const counts = data.counts ?? {};
		const countBox = document.getElementById("dash-counts");
		if (countBox) {
			countBox.innerHTML = Object.entries(counts)
				.map(([key, value]) => `<span class="listora-chip">${key}: ${value}</span>`)
				.join("");
		}
		const list = (items: Array<Record<string, unknown>>, keys: string[]) =>
			items.length
				? items
						.map((item) => `<article class="listora-review">${keys.map((key) => item[key] ?? "").join(" · ")}</article>`)
						.join("")
				: `<div class="listora-empty"><h2>Nothing here</h2><p>This tab fills when you use the directory.</p></div>`;
		const listings = document.getElementById("dash-listings");
		const reviews = document.getElementById("dash-reviews");
		const claims = document.getElementById("dash-claims");
		const favs = document.getElementById("dash-favs");
		if (listings) listings.innerHTML = list(data.listings ?? [], ["title", "status", "city"]);
		if (reviews) reviews.innerHTML = list(data.reviews ?? [], ["title", "stars", "status"]);
		if (claims) claims.innerHTML = list(data.claims ?? [], ["listingId", "status"]);
		if (favs) favs.innerHTML = list(data.favorites ?? [], ["listingId"]);
	}

	document.getElementById("privacy-form")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.target as HTMLFormElement;
		form.setAttribute("aria-busy", "true");
		const response = await fetch("/_emdash/api/plugins/listora/privacy?member_id=demo-member&action=export", {
			credentials: "same-origin",
			headers: { "X-EmDash-Request": "1" },
		});
		const json = await response.json();
		const box = document.getElementById("export-box");
		if (box) {
			box.hidden = false;
			box.textContent = JSON.stringify(json.data, null, 2);
		}
		form.removeAttribute("aria-busy");
	});

	document.getElementById("renew-form")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.target as HTMLFormElement;
		form.setAttribute("aria-busy", "true");
		await fetch("/_emdash/api/plugins/listora/renew", {
			method: "POST",
			credentials: "same-origin",
			headers: { "Content-Type": "application/json", "X-EmDash-Request": "1" },
			body: JSON.stringify({ listingId: form.dataset.id }),
		});
		const status = document.getElementById("renew-status");
		if (status) {
			status.hidden = false;
			status.dataset.tone = "success";
			status.textContent = "Renewed. The listing is back in review.";
		}
		form.removeAttribute("aria-busy");
	});

	load();
</script>
