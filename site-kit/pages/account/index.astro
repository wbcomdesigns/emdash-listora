---
import { getSiteSettings } from "emdash";
import Layout from "../../layouts/ListoraLayout.astro";
import { siteZone } from "../../lib/listora";
import { signedInAs, S } from "../../lib/listora-strings";
import "../../styles/listora-ui.css";

const tab = Astro.url.searchParams.get("tab") || "overview";
// Dates on this page are shown in the site's own time zone, like everywhere else.
const zone = siteZone((await getSiteSettings())?.timezone);
// This page differs per visitor. Sites cache pages without regard to cookies, so say so.
Astro.response.headers.set("Cache-Control", "private, no-store");
const user = Astro.locals.user as { name?: string | null; email?: string } | undefined;
const loginUrl = `/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---

<Layout title={S.account.title} description={S.account.description}>
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>{S.account.heading}</h1>
				<p>{user ? signedInAs(user.name || user.email || "") : S.account.guestIntro}</p>
			</div>
			<a class="listora-btn" href="/listings/submit/">{S.account.add}</a>
		</header>
		{
			user ? null : (
				<div class="listora-empty">
					<h2>{S.account.signInTitle}</h2>
					<p>{S.account.signInBody}</p>
					<a class="listora-btn" href={loginUrl}>{S.common.signIn}</a>
				</div>
			)
		}
		{user ? (
		<div class="listora-dash">
			<nav aria-label={S.account.nav}>
				<a class:list={{ "listora-chip": true, "is-active": tab === "overview" }} href="/account/">{S.account.overview}</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "listings" }} href="/account/?tab=listings">{S.account.myListings}</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "reviews" }} href="/account/?tab=reviews">{S.account.reviews}</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "messages" }} href="/account/?tab=messages">{S.account.messages}<span id="dash-messages-count" class="listora-chip__count" hidden></span></a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "claims" }} href="/account/?tab=claims">{S.account.claims}</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "favorites" }} href="/account/?tab=favorites">{S.account.favorites}</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "profile" }} href="/account/?tab=profile">{S.account.profile}</a>
			</nav>
			<div id="dash-main" data-tab={tab} data-zone={zone}>
				<section id="overview-panel">
					<p class="listora-helper">{S.account.overviewHelp}</p>
					<div class="listora-chips" id="dash-counts"></div>
				</section>
				<section id="list-panel" hidden>
					<h2>{S.account.myListings}</h2>
					<div id="dash-listings"></div>
				</section>
				<section id="reviews-panel" hidden>
					<h2>{S.account.reviewsOf}</h2>
					<p class="listora-helper">{S.account.reviewsHelp}</p>
					<div id="dash-received"></div>
					<h2>{S.account.reviewsWrote}</h2>
					<div id="dash-reviews"></div>
				</section>
				<section id="messages-panel" hidden>
					<h2>{S.account.messages}</h2>
					<p class="listora-helper">{S.account.messagesHelp}</p>
					<div id="dash-messages"></div>
				</section>
				<section id="claims-panel" hidden>
					<h2>{S.account.claims}</h2>
					<div id="dash-claims"></div>
				</section>
				<section id="fav-panel" hidden>
					<h2>{S.account.favorites}</h2>
					<div id="dash-favs"></div>
				</section>
				<section id="profile-panel" hidden>
					<form class="listora-form-section" id="privacy-form">
						<h2>{S.account.profileTitle}</h2>
						<p class="listora-helper">{S.account.downloadHelp}</p>
						<div class="listora-actions">
							<button class="listora-btn" type="submit">{S.account.download}</button>
						</div>
						<p id="export-status" class="listora-status" role="status" hidden></p>
					</form>
					<div class="listora-form-section">
						<h2>{S.account.deleteTitle}</h2>
						<p class="listora-helper">{S.account.deleteRemoves}</p>
						<p class="listora-helper">{S.account.deleteKeeps}</p>
						<div class="listora-actions">
							<button class="listora-btn listora-btn--secondary" type="button" id="erase-btn">{S.account.delete}</button>
						</div>
						<p id="erase-status" class="listora-status" role="status" hidden></p>
					</div>
				</section>
			</div>
		</div>
		) : null}
	</div>
</Layout>

<script>
	import { api, day, esc, uploadPhoto } from "../../lib/listora";
	import { expiresOn, freshCount, outOf5, photoName, photoUsage, renewedUntil, S } from "../../lib/listora-strings";

	const tab = document.getElementById("dash-main")?.getAttribute("data-tab") || "overview";
	const panels: Record<string, string> = {
		overview: "overview-panel",
		listings: "list-panel",
		reviews: "reviews-panel",
		claims: "claims-panel",
		messages: "messages-panel",
		favorites: "fav-panel",
		profile: "profile-panel",
	};
	// On a phone the tabs scroll sideways: bring the open one into view.
	document.querySelector(".listora-chip.is-active")?.scrollIntoView({ block: "nearest", inline: "center" });
	Object.entries(panels).forEach(([key, id]) => {
		const node = document.getElementById(id);
		if (node) node.hidden = key !== tab;
	});

	const LABELS: Record<string, string> = {
		listings: S.account.listings,
		reviews: S.account.reviews,
		claims: S.account.claims,
		favorites: S.account.favorites,
		messages: S.account.messages,
	};

	const STATUS: Record<string, string> = {
		pending: S.account.pending,
		approved: S.account.approved,
		published: S.account.published,
		rejected: S.account.rejected,
	};

	// Each row leads with the listing name (a link once the listing is public), then the given fields.
	function list(items: Array<Record<string, unknown>>, keys: string[]) {
		return items.length
			? `<ul class="listora-dash-list">${items
					.map((item) => {
						const name = esc(item.listing_title || S.account.gone);
						const title = item.listing_url ? `<a href="${esc(item.listing_url)}">${name}</a>` : name;
						const rest = keys
							.map((key) => (key === "status" ? STATUS[String(item.status)] ?? item.status : item[key]))
							.filter(Boolean)
							.map(esc);
						// Only set on the member's own live listings, and only when the site uses expiry.
						const when = item.expired ? S.account.expired : item.expires_at ? expiresOn(day(item.expires_at)) : "";
						if (when) rest.push(esc(when));
						const renew = item.can_renew
							? ` <button type="button" class="listora-btn listora-btn--secondary" data-renew="${esc(item.listingId || item.id)}">${esc(S.account.renew)}</button>`
							: "";
						const id = esc(item.listingId || item.id);
						const waiting = item.edit_pending ? ` <span class="listora-tag">${esc(S.account.changesWaiting)}</span>` : "";
						const edit = item.can_edit
							? ` <a class="listora-btn listora-btn--secondary" href="/listings/submit/?edit=${id}">${esc(item.edit_pending ? S.account.editAgain : S.account.edit)}</a>`
							: "";
						return `<li class="listora-review listora-row"><span class="listora-row__text"><strong>${title}</strong>${rest.length ? ` · ${rest.join(" · ")}` : ""}${waiting}</span><span class="listora-row__actions">${edit}${renew}</span>${photosHtml(item)}</li>`;
					})
					.join("")}</ul>`
			: `<div class="listora-empty"><h2>${esc(S.account.emptyTitle)}</h2><p>${esc(S.account.emptyBody)}</p></div>`;
	}

	// An owner's photos for one listing: what is there, what is waiting, and a way to add one.
	// Only present when the site has photos turned on.
	function photosHtml(item: Record<string, unknown>): string {
		const limit = Number(item.photo_limit) || 0;
		if (!limit) return "";
		const photos = (item.photos ?? []) as Array<{ id: string; url: string; status: string; label?: string }>;
		const id = esc(item.listingId || item.id);
		const shown = photos
			.map(
				(photo, index) =>
					// A waiting photo has no address to show: only the site's admin can see it until it is approved.
					photo.status === "approved" && photo.url
						? `<li class="listora-photos__item"><img src="${esc(photo.url)}" alt="${esc(photo.label || photoName(index + 1))}" width="120" height="88" loading="lazy" /><span>${esc(S.account.onListing)}</span></li>`
						: `<li class="listora-photos__item"><span class="listora-photos__waiting" aria-hidden="true"></span><span class="listora-photos__name">${esc(photo.label || photoName(index + 1))}</span><span>${esc(S.account.waiting)}</span><button type="button" class="listora-btn listora-btn--secondary" data-photo-remove="${esc(photo.id)}">${esc(S.account.remove)}</button></li>`,
			)
			.join("");
		const add =
			photos.length < limit
				? `<label class="listora-btn listora-btn--secondary listora-photos__add"><input type="file" accept="image/jpeg,image/png,image/webp" data-photo-add="${id}" />${esc(S.account.addPhoto)}</label>`
				: "";
		return `<div class="listora-photos"><p class="listora-meta">${esc(photoUsage(photos.length, limit))}</p>${shown ? `<ul class="listora-photos__list">${shown}</ul>` : ""}<div>${add} <span class="listora-status" role="status" data-photo-status="${id}" hidden></span></div></div>`;
	}

	function fill(id: string, html: string) {
		const node = document.getElementById(id);
		if (node) node.innerHTML = html;
	}

	// Add a photo: the file is sent as soon as it is chosen.
	document.addEventListener("change", async (event) => {
		const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-photo-add]");
		const file = input?.files?.[0];
		if (!input || !file) return;
		const listingId = input.dataset.photoAdd || "";
		const status = document.querySelector<HTMLElement>(`[data-photo-status="${CSS.escape(listingId)}"]`);
		const say = (text: string, tone: string) => {
			if (!status) return;
			status.hidden = false;
			status.dataset.tone = tone;
			status.textContent = text;
		};
		input.disabled = true;
		say(S.account.adding, "info");
		const data = await uploadPhoto(listingId, file);
		input.disabled = false;
		input.value = "";
		if (!data.ok) return say(data.error?.message || S.account.photoFailed, "error");
		await load();
		const after = document.querySelector<HTMLElement>(`[data-photo-status="${CSS.escape(listingId)}"]`);
		if (after) {
			after.hidden = false;
			after.dataset.tone = "success";
			after.textContent = S.account.photoAdded;
		}
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-photo-remove]");
		if (!button) return;
		button.disabled = true;
		const data = await api("photo_remove", { id: button.dataset.photoRemove });
		if (data.ok) return load();
		button.disabled = false;
		button.insertAdjacentHTML(
			"afterend",
			`<span class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || S.account.photoRemoveFailed)}</span>`,
		);
	});

	document.addEventListener("submit", async (event) => {
		const form = (event.target as HTMLElement).closest<HTMLFormElement>("form[data-reply]");
		if (!form) return;
		event.preventDefault();
		const button = form.querySelector("button") as HTMLButtonElement;
		form.querySelector("[role=alert]")?.remove();
		button.disabled = true;
		const data = await api("reply", { listingId: form.dataset.listing, ref: form.dataset.reply, text: new FormData(form).get("text") });
		if (data.ok) return load();
		button.disabled = false;
		form.insertAdjacentHTML(
			"beforeend",
			`<p class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || S.account.replyFailed)}</p>`,
		);
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-message]");
		if (!button) return;
		button.disabled = true;
		const data = await api("message", { id: button.dataset.message, done: button.dataset.done === "1" });
		if (data.ok) return load();
		button.disabled = false;
		button.insertAdjacentHTML(
			"afterend",
			` <span class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || S.account.messageFailed)}</span>`,
		);
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-renew]");
		if (!button) return;
		button.disabled = true;
		const data = await api("renew", { listingId: button.dataset.renew });
		if (data.ok) {
			await load();
			const until = day(data.expires_at);
			document
				.getElementById("dash-listings")
				?.insertAdjacentHTML("afterbegin", `<p class="listora-status" data-tone="success" role="status">${esc(renewedUntil(until))}</p>`);
			return;
		}
		button.disabled = false;
		button.insertAdjacentHTML(
			"afterend",
			` <span class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || S.account.renewFailed)}</span>`,
		);
	});

	async function load() {
		if (!document.getElementById("dash-main")) return;
		const data = await api("dashboard");
		if (!data.ok) {
			fill("dash-counts", `<p class="listora-status" data-tone="error">${esc(data.error?.message || S.account.loadFailed)}</p>`);
			return;
		}
		fill(
			"dash-counts",
			Object.entries((data.counts ?? {}) as Record<string, number>)
				.map(([key, value]) => `<a class="listora-chip" href="/account/?tab=${esc(key)}">${esc(LABELS[key] ?? key)}: ${esc(value)}</a>`)
				.join(""),
		);
		const fresh = Number((data.counts as Record<string, number> | undefined)?.messages) || 0;
		const badge = document.getElementById("dash-messages-count");
		if (badge) {
			badge.hidden = fresh === 0;
			badge.textContent = String(fresh);
			badge.setAttribute("aria-label", freshCount(fresh));
		}
		type Rows = Array<Record<string, unknown>>;
		fill("dash-listings", list(data.listings as Rows, ["city", "status"]));
		fill("dash-reviews", list(data.reviews as Rows, ["body", "status"]));
		const received = (data.received ?? []) as Rows;
		fill(
			"dash-received",
			received.length
				? `<ul class="listora-dash-list">${received
						.map((item) => {
							const stars = Number(item.stars) || 0;
							const text = [item.title, item.body].filter(Boolean).join(": ");
							const shown = item.reply
								? `<div class="listora-reply"><p class="listora-reply__label">${esc(S.account.yourReply)}</p><p>${esc(item.reply)}</p></div>`
								: "";
							const waiting = item.reply_waiting
								? `<div class="listora-reply"><p class="listora-reply__label"><span class="listora-tag">${esc(S.account.waiting)}</span></p><p>${esc(item.reply_waiting)}</p></div>`
								: "";
							const id = esc(item.ref);
							const label = item.reply || item.reply_waiting ? S.account.changeReply : S.account.reply;
							return `<li class="listora-review listora-message">
								<p class="listora-message__head"><strong>${esc(item.listing_title || S.account.aListing)}</strong></p>
								<p class="listora-meta">${esc(item.author || S.account.aMember)} · <span aria-label="${esc(outOf5(stars))}">${"★".repeat(stars)}</span> · ${esc(day(item.createdAt))}</p>
								${text ? `<p class="listora-message__body">${esc(text)}</p>` : ""}
								${shown}${waiting}
								<details class="listora-reply-form">
									<summary class="listora-btn listora-btn--secondary">${esc(label)}</summary>
									<form data-reply="${id}" data-listing="${esc(item.listingId)}" class="listora-form">
										<label class="listora-label" for="reply-${id}">${esc(S.account.replyLabel)}</label>
										<textarea id="reply-${id}" class="listora-input" name="text" rows="3" maxlength="1000" required>${esc(item.reply_waiting || item.reply || "")}</textarea>
										<button type="submit" class="listora-btn">${esc(S.account.sendReply)}</button>
									</form>
								</details>
							</li>`;
						})
						.join("")}</ul>`
				: `<div class="listora-empty"><h2>${esc(S.account.noReviewsTitle)}</h2><p>${esc(S.account.noReviewsBody)}</p></div>`,
		);
		fill("dash-claims", list(data.claims as Rows, ["status"]));
		// Visitors wrote these: every value goes through esc, and the address is only ever a mailto.
		const messages = (data.messages ?? []) as Rows;
		fill(
			"dash-messages",
			messages.length
				? `<ul class="listora-dash-list">${messages
						.map((item) => {
							const from = esc(item.name || S.account.noName);
							const mail = item.email ? ` · <a href="mailto:${esc(item.email)}">${esc(item.email)}</a>` : "";
							// "New" is said in words, not by colour alone.
							const state = item.done ? "" : `<span class="listora-tag">${esc(S.account.fresh)}</span> `;
							const button = `<button type="button" class="listora-btn listora-btn--secondary" data-message="${esc(item.id)}" data-done="${item.done ? "0" : "1"}">${esc(item.done ? S.account.markNew : S.account.markDone)}</button>`;
							return `<li class="listora-review listora-message${item.done ? " is-done" : ""}">
								<p class="listora-message__head">${state}<strong>${esc(item.listing_title || S.account.aListing)}</strong></p>
								<p class="listora-meta">${esc(S.account.from)} ${from}${mail} · ${esc(day(item.createdAt))}</p>
								<p class="listora-message__body">${esc(item.message)}</p>
								${button}
							</li>`;
						})
						.join("")}</ul>`
				: `<div class="listora-empty"><h2>${esc(S.account.noMessagesTitle)}</h2><p>${esc(S.account.noMessagesBody)}</p></div>`,
		);
		fill("dash-favs", list(data.favorites as Rows, []));
	}

	document.getElementById("privacy-form")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.target as HTMLFormElement;
		form.setAttribute("aria-busy", "true");
		const data = await api("privacy");
		form.removeAttribute("aria-busy");
		const status = document.getElementById("export-status");
		const say = (text: string, tone: string) => {
			if (!status) return;
			status.hidden = false;
			status.dataset.tone = tone;
			status.textContent = text;
		};
		if (!data.ok) return say(data.error?.message || S.account.exportFailed, "error");
		// A real file, not text to copy.
		const { ok: _ok, erases: _erases, keeps: _keeps, ...mine } = data as Record<string, unknown>;
		const link = document.createElement("a");
		link.href = URL.createObjectURL(new Blob([JSON.stringify(mine, null, 2)], { type: "application/json" }));
		link.download = "my-directory-data.json";
		document.body.append(link);
		link.click();
		link.remove();
		URL.revokeObjectURL(link.href);
		say(S.account.exported, "success");
	});

	// Two clicks instead of a browser confirm box.
	const eraseBtn = document.getElementById("erase-btn") as HTMLButtonElement | null;
	eraseBtn?.addEventListener("click", async () => {
		if (eraseBtn.dataset.armed !== "1") {
			eraseBtn.dataset.armed = "1";
			eraseBtn.textContent = S.account.deleteAgain;
			return;
		}
		eraseBtn.setAttribute("aria-busy", "true");
		const result = await api("privacy", { action: "erase" });
		eraseBtn.removeAttribute("aria-busy");
		eraseBtn.dataset.armed = "";
		eraseBtn.textContent = S.account.delete;
		const status = document.getElementById("erase-status");
		if (status) {
			status.hidden = false;
			status.dataset.tone = result.ok ? "success" : "error";
			status.textContent = result.ok ? S.account.deleted : result.error?.message || S.account.couldNotDelete;
		}
		if (result.ok) load();
	});

	load();
</script>
