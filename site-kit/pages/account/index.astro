---
import Layout from "../../layouts/ListoraLayout.astro";
import "../../styles/listora-ui.css";

const tab = Astro.url.searchParams.get("tab") || "overview";
// This page differs per visitor. Sites cache pages without regard to cookies, so say so.
Astro.response.headers.set("Cache-Control", "private, no-store");
const user = Astro.locals.user as { name?: string | null; email?: string } | undefined;
const loginUrl = `/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---

<Layout title="Your listings" description="Owner dashboard for listings, reviews, claims, and favorites.">
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>Dashboard</h1>
				<p>{user ? `Signed in as ${user.name || user.email}.` : "Your listings, reviews, claims and saved places."}</p>
			</div>
			<a class="listora-btn" href="/listings/submit/">Add a listing</a>
		</header>
		{
			user ? null : (
				<div class="listora-empty">
					<h2>Sign in to see your dashboard</h2>
					<p>Your listings, reviews, claims and saved places live here.</p>
					<a class="listora-btn" href={loginUrl}>Sign in</a>
				</div>
			)
		}
		{user ? (
		<div class="listora-dash">
			<nav aria-label="Dashboard">
				<a class:list={{ "listora-chip": true, "is-active": tab === "overview" }} href="/account/">Overview</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "listings" }} href="/account/?tab=listings">My listings</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "reviews" }} href="/account/?tab=reviews">Reviews</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "claims" }} href="/account/?tab=claims">Claims</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "favorites" }} href="/account/?tab=favorites">Favorites</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "profile" }} href="/account/?tab=profile">Profile</a>
			</nav>
			<div id="dash-main" data-tab={tab}>
				<section id="overview-panel">
					<div class="listora-chips" id="dash-counts"></div>
				</section>
				<section id="list-panel" hidden>
					<h2>My listings</h2>
					<div id="dash-listings"></div>
				</section>
				<section id="reviews-panel" hidden>
					<h2>Reviews</h2>
					<div id="dash-reviews"></div>
				</section>
				<section id="claims-panel" hidden>
					<h2>Claims</h2>
					<div id="dash-claims"></div>
				</section>
				<section id="fav-panel" hidden>
					<h2>Favorites</h2>
					<div id="dash-favs"></div>
				</section>
				<section id="profile-panel" hidden>
					<form class="listora-form-section" id="privacy-form">
						<h2>Profile and privacy</h2>
						<p class="listora-helper">Download your reviews, claims and favorites as JSON.</p>
						<div class="listora-actions">
							<button class="listora-btn" type="submit">Export my data</button>
						</div>
						<pre id="export-box" hidden></pre>
					</form>
					<div class="listora-form-section">
						<h2>Delete my data</h2>
						<p class="listora-helper">Removes your reviews, claims and saved listings for good. Listings you added stay on the site.</p>
						<div class="listora-actions">
							<button class="listora-btn listora-btn--secondary" type="button" id="erase-btn">Delete my reviews, claims and saved listings</button>
						</div>
						<p id="erase-status" class="listora-status" role="status" hidden></p>
					</div>
				</section>
			</div>
		</div>
		) : null}
	</div>
</Layout>

<script>
	import { api, esc } from "../../lib/listora";

	const tab = document.getElementById("dash-main")?.getAttribute("data-tab") || "overview";
	const panels: Record<string, string> = {
		overview: "overview-panel",
		listings: "list-panel",
		reviews: "reviews-panel",
		claims: "claims-panel",
		favorites: "fav-panel",
		profile: "profile-panel",
	};
	Object.entries(panels).forEach(([key, id]) => {
		const node = document.getElementById(id);
		if (node) node.hidden = key !== tab;
	});

	const LABELS: Record<string, string> = { listings: "Listings", reviews: "Reviews", claims: "Claims", favorites: "Favorites" };

	const STATUS: Record<string, string> = {
		pending: "Awaiting approval",
		approved: "Approved",
		published: "Published",
		rejected: "Not approved",
	};

	// Each row leads with the listing name (a link once the listing is public), then the given fields.
	function list(items: Array<Record<string, unknown>>, keys: string[]) {
		return items.length
			? `<ul class="listora-dash-list">${items
					.map((item) => {
						const name = esc(item.listing_title || "Listing no longer available");
						const title = item.listing_url ? `<a href="${esc(item.listing_url)}">${name}</a>` : name;
						const rest = keys
							.map((key) => (key === "status" ? STATUS[String(item.status)] ?? item.status : item[key]))
							.filter(Boolean)
							.map(esc);
						return `<li class="listora-review"><strong>${title}</strong>${rest.length ? ` · ${rest.join(" · ")}` : ""}</li>`;
					})
					.join("")}</ul>`
			: `<div class="listora-empty"><h2>Nothing here yet</h2><p>This tab fills as you use the directory.</p></div>`;
	}

	function fill(id: string, html: string) {
		const node = document.getElementById(id);
		if (node) node.innerHTML = html;
	}

	async function load() {
		if (!document.getElementById("dash-main")) return;
		const data = await api("dashboard");
		if (!data.ok) {
			fill("dash-counts", `<p class="listora-status" data-tone="error">${esc(data.error?.message || "Could not load your dashboard.")}</p>`);
			return;
		}
		fill(
			"dash-counts",
			Object.entries((data.counts ?? {}) as Record<string, number>)
				.map(([key, value]) => `<span class="listora-chip">${esc(LABELS[key] ?? key)}: ${esc(value)}</span>`)
				.join(""),
		);
		type Rows = Array<Record<string, unknown>>;
		fill("dash-listings", list(data.listings as Rows, ["city", "status"]));
		fill("dash-reviews", list(data.reviews as Rows, ["body", "status"]));
		fill("dash-claims", list(data.claims as Rows, ["status"]));
		fill("dash-favs", list(data.favorites as Rows, []));
	}

	document.getElementById("privacy-form")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.target as HTMLFormElement;
		form.setAttribute("aria-busy", "true");
		const data = await api("privacy");
		form.removeAttribute("aria-busy");
		const box = document.getElementById("export-box");
		if (box) {
			box.hidden = false;
			box.textContent = JSON.stringify(data, null, 2);
		}
	});

	// Two clicks instead of a browser confirm box.
	const eraseBtn = document.getElementById("erase-btn") as HTMLButtonElement | null;
	eraseBtn?.addEventListener("click", async () => {
		if (eraseBtn.dataset.armed !== "1") {
			eraseBtn.dataset.armed = "1";
			eraseBtn.textContent = "Click again to delete them for good";
			return;
		}
		eraseBtn.setAttribute("aria-busy", "true");
		const result = await api("privacy", { action: "erase" });
		eraseBtn.removeAttribute("aria-busy");
		eraseBtn.dataset.armed = "";
		eraseBtn.textContent = "Delete my reviews, claims and saved listings";
		const status = document.getElementById("erase-status");
		if (status) {
			status.hidden = false;
			status.dataset.tone = result.ok ? "success" : "error";
			status.textContent = result.ok ? "Your reviews, claims and saved listings were deleted." : result.error?.message || "Could not delete. Try again.";
		}
		if (result.ok) load();
	});

	load();
</script>
