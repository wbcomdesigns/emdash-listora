---
import { getSiteSettings } from "emdash";
import Layout from "../../layouts/ListoraLayout.astro";
import { siteZone } from "../../lib/listora";
import "../../styles/listora-ui.css";

const tab = Astro.url.searchParams.get("tab") || "overview";
// Dates on this page are shown in the site's own time zone, like everywhere else.
const zone = siteZone((await getSiteSettings())?.timezone);
// This page differs per visitor. Sites cache pages without regard to cookies, so say so.
Astro.response.headers.set("Cache-Control", "private, no-store");
const user = Astro.locals.user as { name?: string | null; email?: string } | undefined;
const loginUrl = `/_emdash/admin/login?redirect=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`;
---

<Layout title="Your listings" description="Owner dashboard for listings, reviews, claims, and favorites.">
	<div class="listora-block">
		<header class="listora-page-head">
			<div>
				<h1>Dashboard</h1>
				<p>{user ? `Signed in as ${user.name || user.email}.` : "Your listings, reviews, claims and saved places."}</p>
			</div>
			<a class="listora-btn" href="/listings/submit/">Add a listing</a>
		</header>
		{
			user ? null : (
				<div class="listora-empty">
					<h2>Sign in to see your dashboard</h2>
					<p>Your listings, reviews, claims and saved places live here.</p>
					<a class="listora-btn" href={loginUrl}>Sign in</a>
				</div>
			)
		}
		{user ? (
		<div class="listora-dash">
			<nav aria-label="Dashboard">
				<a class:list={{ "listora-chip": true, "is-active": tab === "overview" }} href="/account/">Overview</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "listings" }} href="/account/?tab=listings">My listings</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "reviews" }} href="/account/?tab=reviews">Reviews</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "messages" }} href="/account/?tab=messages">Messages<span id="dash-messages-count" class="listora-chip__count" hidden></span></a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "claims" }} href="/account/?tab=claims">Claims</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "favorites" }} href="/account/?tab=favorites">Favorites</a>
				<a class:list={{ "listora-chip": true, "is-active": tab === "profile" }} href="/account/?tab=profile">Profile</a>
			</nav>
			<div id="dash-main" data-tab={tab} data-zone={zone}>
				<section id="overview-panel">
					<p class="listora-helper">What you have in the directory. Choose one to open it.</p>
					<div class="listora-chips" id="dash-counts"></div>
				</section>
				<section id="list-panel" hidden>
					<h2>My listings</h2>
					<div id="dash-listings"></div>
				</section>
				<section id="reviews-panel" hidden>
					<h2>Reviews of your listings</h2>
					<p class="listora-helper">Reply once to each review. Your reply shows under it after it is approved.</p>
					<div id="dash-received"></div>
					<h2>Reviews you wrote</h2>
					<div id="dash-reviews"></div>
				</section>
				<section id="messages-panel" hidden>
					<h2>Messages</h2>
					<p class="listora-helper">Sent by visitors from your listing pages. Reply to them by email.</p>
					<div id="dash-messages"></div>
				</section>
				<section id="claims-panel" hidden>
					<h2>Claims</h2>
					<div id="dash-claims"></div>
				</section>
				<section id="fav-panel" hidden>
					<h2>Favorites</h2>
					<div id="dash-favs"></div>
				</section>
				<section id="profile-panel" hidden>
					<form class="listora-form-section" id="privacy-form">
						<h2>Profile and privacy</h2>
						<p class="listora-helper">Download a file with your reviews, claims and saved listings.</p>
						<div class="listora-actions">
							<button class="listora-btn" type="submit">Download my data</button>
						</div>
						<p id="export-status" class="listora-status" role="status" hidden></p>
					</form>
					<div class="listora-form-section">
						<h2>Delete my data</h2>
						<p class="listora-helper">This removes, for good: your reviews, your claims, your saved listings, your replies to reviews, any changes or photos still waiting for approval, and your stored email address.</p>
						<p class="listora-helper">It keeps: listings you added, which stay in the directory, and photos already approved on a listing. Ask the site to remove those.</p>
						<div class="listora-actions">
							<button class="listora-btn listora-btn--secondary" type="button" id="erase-btn">Delete my data</button>
						</div>
						<p id="erase-status" class="listora-status" role="status" hidden></p>
					</div>
				</section>
			</div>
		</div>
		) : null}
	</div>
</Layout>

<script>
	import { api, day, esc, uploadPhoto } from "../../lib/listora";

	const tab = document.getElementById("dash-main")?.getAttribute("data-tab") || "overview";
	const panels: Record<string, string> = {
		overview: "overview-panel",
		listings: "list-panel",
		reviews: "reviews-panel",
		claims: "claims-panel",
		messages: "messages-panel",
		favorites: "fav-panel",
		profile: "profile-panel",
	};
	// On a phone the tabs scroll sideways: bring the open one into view.
	document.querySelector(".listora-chip.is-active")?.scrollIntoView({ block: "nearest", inline: "center" });
	Object.entries(panels).forEach(([key, id]) => {
		const node = document.getElementById(id);
		if (node) node.hidden = key !== tab;
	});

	const LABELS: Record<string, string> = { listings: "Listings", reviews: "Reviews", claims: "Claims", favorites: "Favorites", messages: "Messages" };

	const STATUS: Record<string, string> = {
		pending: "Awaiting approval",
		approved: "Approved",
		published: "Published",
		rejected: "Not approved",
	};

	// Each row leads with the listing name (a link once the listing is public), then the given fields.
	function list(items: Array<Record<string, unknown>>, keys: string[]) {
		return items.length
			? `<ul class="listora-dash-list">${items
					.map((item) => {
						const name = esc(item.listing_title || "Listing no longer available");
						const title = item.listing_url ? `<a href="${esc(item.listing_url)}">${name}</a>` : name;
						const rest = keys
							.map((key) => (key === "status" ? STATUS[String(item.status)] ?? item.status : item[key]))
							.filter(Boolean)
							.map(esc);
						// Only set on the member's own live listings, and only when the site uses expiry.
						const when = item.expired
							? "Expired"
							: item.expires_at
								? `Expires ${day(item.expires_at)}`
								: "";
						if (when) rest.push(esc(when));
						const renew = item.can_renew
							? ` <button type="button" class="listora-btn listora-btn--secondary" data-renew="${esc(item.listingId || item.id)}">Renew</button>`
							: "";
						const id = esc(item.listingId || item.id);
						const waiting = item.edit_pending ? ' <span class="listora-tag">Changes waiting for approval</span>' : "";
						const edit = item.can_edit
							? ` <a class="listora-btn listora-btn--secondary" href="/listings/submit/?edit=${id}">${item.edit_pending ? "Edit again" : "Edit"}</a>`
							: "";
						return `<li class="listora-review listora-row"><span class="listora-row__text"><strong>${title}</strong>${rest.length ? ` · ${rest.join(" · ")}` : ""}${waiting}</span><span class="listora-row__actions">${edit}${renew}</span>${photosHtml(item)}</li>`;
					})
					.join("")}</ul>`
			: `<div class="listora-empty"><h2>Nothing here yet</h2><p>This tab fills as you use the directory.</p></div>`;
	}

	// An owner's photos for one listing: what is there, what is waiting, and a way to add one.
	// Only present when the site has photos turned on.
	function photosHtml(item: Record<string, unknown>): string {
		const limit = Number(item.photo_limit) || 0;
		if (!limit) return "";
		const photos = (item.photos ?? []) as Array<{ id: string; url: string; status: string; label?: string }>;
		const id = esc(item.listingId || item.id);
		const shown = photos
			.map(
				(photo, index) =>
					// A waiting photo has no address to show: only the site's admin can see it until it is approved.
					photo.status === "approved" && photo.url
						? `<li class="listora-photos__item"><img src="${esc(photo.url)}" alt="${esc(photo.label || `Photo ${index + 1}`)}" width="120" height="88" loading="lazy" /><span>On your listing</span></li>`
						: `<li class="listora-photos__item"><span class="listora-photos__waiting" aria-hidden="true"></span><span class="listora-photos__name">${esc(photo.label || `Photo ${index + 1}`)}</span><span>Waiting for approval</span><button type="button" class="listora-btn listora-btn--secondary" data-photo-remove="${esc(photo.id)}">Remove</button></li>`,
			)
			.join("");
		const add =
			photos.length < limit
				? `<label class="listora-btn listora-btn--secondary listora-photos__add"><input type="file" accept="image/jpeg,image/png,image/webp" data-photo-add="${id}" />Add a photo</label>`
				: "";
		return `<div class="listora-photos"><p class="listora-meta">Photos: ${photos.length} of ${limit}. JPEG, PNG or WebP, up to 5 MB each. Each one shows after it is approved.</p>${shown ? `<ul class="listora-photos__list">${shown}</ul>` : ""}<div>${add} <span class="listora-status" role="status" data-photo-status="${id}" hidden></span></div></div>`;
	}

	function fill(id: string, html: string) {
		const node = document.getElementById(id);
		if (node) node.innerHTML = html;
	}

	// Add a photo: the file is sent as soon as it is chosen.
	document.addEventListener("change", async (event) => {
		const input = (event.target as HTMLElement).closest<HTMLInputElement>("[data-photo-add]");
		const file = input?.files?.[0];
		if (!input || !file) return;
		const listingId = input.dataset.photoAdd || "";
		const status = document.querySelector<HTMLElement>(`[data-photo-status="${CSS.escape(listingId)}"]`);
		const say = (text: string, tone: string) => {
			if (!status) return;
			status.hidden = false;
			status.dataset.tone = tone;
			status.textContent = text;
		};
		input.disabled = true;
		say("Adding your photo...", "info");
		const data = await uploadPhoto(listingId, file);
		input.disabled = false;
		input.value = "";
		if (!data.ok) return say(data.error?.message || "The photo could not be added. Try again.", "error");
		await load();
		const after = document.querySelector<HTMLElement>(`[data-photo-status="${CSS.escape(listingId)}"]`);
		if (after) {
			after.hidden = false;
			after.dataset.tone = "success";
			after.textContent = "Photo added. It shows on your listing after it is approved.";
		}
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-photo-remove]");
		if (!button) return;
		button.disabled = true;
		const data = await api("photo_remove", { id: button.dataset.photoRemove });
		if (data.ok) return load();
		button.disabled = false;
		button.insertAdjacentHTML(
			"afterend",
			`<span class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || "Could not remove that photo.")}</span>`,
		);
	});

	document.addEventListener("submit", async (event) => {
		const form = (event.target as HTMLElement).closest<HTMLFormElement>("form[data-reply]");
		if (!form) return;
		event.preventDefault();
		const button = form.querySelector("button") as HTMLButtonElement;
		form.querySelector("[role=alert]")?.remove();
		button.disabled = true;
		const data = await api("reply", { listingId: form.dataset.listing, ref: form.dataset.reply, text: new FormData(form).get("text") });
		if (data.ok) return load();
		button.disabled = false;
		form.insertAdjacentHTML(
			"beforeend",
			`<p class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || "Could not send your reply.")}</p>`,
		);
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-message]");
		if (!button) return;
		button.disabled = true;
		const data = await api("message", { id: button.dataset.message, done: button.dataset.done === "1" });
		if (data.ok) return load();
		button.disabled = false;
		button.insertAdjacentHTML(
			"afterend",
			` <span class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || "Could not update that message.")}</span>`,
		);
	});

	document.addEventListener("click", async (event) => {
		const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-renew]");
		if (!button) return;
		button.disabled = true;
		const data = await api("renew", { listingId: button.dataset.renew });
		if (data.ok) {
			await load();
			const until = day(data.expires_at);
			document
				.getElementById("dash-listings")
				?.insertAdjacentHTML("afterbegin", `<p class="listora-status" data-tone="success" role="status">Renewed until ${esc(until)}.</p>`);
			return;
		}
		button.disabled = false;
		button.insertAdjacentHTML(
			"afterend",
			` <span class="listora-status" data-tone="error" role="alert">${esc(data.error?.message || "Could not renew.")}</span>`,
		);
	});

	async function load() {
		if (!document.getElementById("dash-main")) return;
		const data = await api("dashboard");
		if (!data.ok) {
			fill("dash-counts", `<p class="listora-status" data-tone="error">${esc(data.error?.message || "Could not load your dashboard.")}</p>`);
			return;
		}
		fill(
			"dash-counts",
			Object.entries((data.counts ?? {}) as Record<string, number>)
				.map(([key, value]) => `<a class="listora-chip" href="/account/?tab=${esc(key)}">${esc(LABELS[key] ?? key)}: ${esc(value)}</a>`)
				.join(""),
		);
		const fresh = Number((data.counts as Record<string, number> | undefined)?.messages) || 0;
		const badge = document.getElementById("dash-messages-count");
		if (badge) {
			badge.hidden = fresh === 0;
			badge.textContent = String(fresh);
			badge.setAttribute("aria-label", `${fresh} new`);
		}
		type Rows = Array<Record<string, unknown>>;
		fill("dash-listings", list(data.listings as Rows, ["city", "status"]));
		fill("dash-reviews", list(data.reviews as Rows, ["body", "status"]));
		const received = (data.received ?? []) as Rows;
		fill(
			"dash-received",
			received.length
				? `<ul class="listora-dash-list">${received
						.map((item) => {
							const stars = Number(item.stars) || 0;
							const text = [item.title, item.body].filter(Boolean).join(": ");
							const shown = item.reply
								? `<div class="listora-reply"><p class="listora-reply__label">Your reply</p><p>${esc(item.reply)}</p></div>`
								: "";
							const waiting = item.reply_waiting
								? `<div class="listora-reply"><p class="listora-reply__label"><span class="listora-tag">Waiting for approval</span></p><p>${esc(item.reply_waiting)}</p></div>`
								: "";
							const id = esc(item.ref);
							const label = item.reply || item.reply_waiting ? "Change your reply" : "Reply";
							return `<li class="listora-review listora-message">
								<p class="listora-message__head"><strong>${esc(item.listing_title || "Listing")}</strong></p>
								<p class="listora-meta">${esc(item.author || "A member")} · <span aria-label="${stars} out of 5">${"★".repeat(stars)}</span> · ${esc(day(item.createdAt))}</p>
								${text ? `<p class="listora-message__body">${esc(text)}</p>` : ""}
								${shown}${waiting}
								<details class="listora-reply-form">
									<summary class="listora-btn listora-btn--secondary">${label}</summary>
									<form data-reply="${id}" data-listing="${esc(item.listingId)}" class="listora-form">
										<label class="listora-label" for="reply-${id}">Your reply (public, up to 1000 characters)</label>
										<textarea id="reply-${id}" class="listora-input" name="text" rows="3" maxlength="1000" required>${esc(item.reply_waiting || item.reply || "")}</textarea>
										<button type="submit" class="listora-btn">Send for approval</button>
									</form>
								</details>
							</li>`;
						})
						.join("")}</ul>`
				: `<div class="listora-empty"><h2>No reviews yet</h2><p>Reviews of your listings show here once they are published.</p></div>`,
		);
		fill("dash-claims", list(data.claims as Rows, ["status"]));
		// Visitors wrote these: every value goes through esc, and the address is only ever a mailto.
		const messages = (data.messages ?? []) as Rows;
		fill(
			"dash-messages",
			messages.length
				? `<ul class="listora-dash-list">${messages
						.map((item) => {
							const from = esc(item.name || "No name given");
							const mail = item.email ? ` · <a href="mailto:${esc(item.email)}">${esc(item.email)}</a>` : "";
							// "New" is said in words, not by colour alone.
							const state = item.done ? "" : '<span class="listora-tag">New</span> ';
							const button = `<button type="button" class="listora-btn listora-btn--secondary" data-message="${esc(item.id)}" data-done="${item.done ? "0" : "1"}">${item.done ? "Mark as new" : "Mark as done"}</button>`;
							return `<li class="listora-review listora-message${item.done ? " is-done" : ""}">
								<p class="listora-message__head">${state}<strong>${esc(item.listing_title || "Listing")}</strong></p>
								<p class="listora-meta">From ${from}${mail} · ${esc(day(item.createdAt))}</p>
								<p class="listora-message__body">${esc(item.message)}</p>
								${button}
							</li>`;
						})
						.join("")}</ul>`
				: `<div class="listora-empty"><h2>No messages yet</h2><p>Messages from your listing pages show here.</p></div>`,
		);
		fill("dash-favs", list(data.favorites as Rows, []));
	}

	document.getElementById("privacy-form")?.addEventListener("submit", async (event) => {
		event.preventDefault();
		const form = event.target as HTMLFormElement;
		form.setAttribute("aria-busy", "true");
		const data = await api("privacy");
		form.removeAttribute("aria-busy");
		const status = document.getElementById("export-status");
		const say = (text: string, tone: string) => {
			if (!status) return;
			status.hidden = false;
			status.dataset.tone = tone;
			status.textContent = text;
		};
		if (!data.ok) return say(data.error?.message || "Could not prepare your data. Try again.", "error");
		// A real file, not text to copy.
		const { ok: _ok, erases: _erases, keeps: _keeps, ...mine } = data as Record<string, unknown>;
		const link = document.createElement("a");
		link.href = URL.createObjectURL(new Blob([JSON.stringify(mine, null, 2)], { type: "application/json" }));
		link.download = "my-directory-data.json";
		document.body.append(link);
		link.click();
		link.remove();
		URL.revokeObjectURL(link.href);
		say("Your file was downloaded.", "success");
	});

	// Two clicks instead of a browser confirm box.
	const eraseBtn = document.getElementById("erase-btn") as HTMLButtonElement | null;
	eraseBtn?.addEventListener("click", async () => {
		if (eraseBtn.dataset.armed !== "1") {
			eraseBtn.dataset.armed = "1";
			eraseBtn.textContent = "Click again to delete them for good";
			return;
		}
		eraseBtn.setAttribute("aria-busy", "true");
		const result = await api("privacy", { action: "erase" });
		eraseBtn.removeAttribute("aria-busy");
		eraseBtn.dataset.armed = "";
		eraseBtn.textContent = "Delete my data";
		const status = document.getElementById("erase-status");
		if (status) {
			status.hidden = false;
			status.dataset.tone = result.ok ? "success" : "error";
			status.textContent = result.ok ? "Your reviews, claims and saved listings were deleted." : result.error?.message || "Could not delete. Try again.";
		}
		if (result.ok) load();
	});

	load();
</script>
